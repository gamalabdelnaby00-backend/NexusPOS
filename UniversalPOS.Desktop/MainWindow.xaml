<Window x:Class="UniversalPOS.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NexusPOS" Width="1400" Height="820" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="#EAF1FA" FontFamily="Segoe UI">
    <Grid x:Name="RootGrid" FlowDirection="LeftToRight">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="SidebarBorder" Grid.Column="0" Background="#082A52" Padding="14,18,14,14">
            <DockPanel>
                <StackPanel x:Name="BrandPanel" DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,0,0,22"/>
                <StackPanel x:Name="SidebarFooter" DockPanel.Dock="Bottom" Margin="0,8,0,0"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="NavPanel"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid x:Name="ContentRoot" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="66"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border x:Name="HeaderBorder" Grid.Row="0" Background="White" BorderBrush="#D8E4F3" BorderThickness="0,0,0,1" Padding="26,0"/>
            <ContentControl x:Name="PageHost" Grid.Row="1" Margin="28,22,28,16" IsTabStop="False"/>
        </Grid>
    </Grid>
</Window>