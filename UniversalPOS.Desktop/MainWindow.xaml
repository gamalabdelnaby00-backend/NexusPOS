                                       Text="تقارير حسب الصلاحيات"
                                       TextWrapping="Wrap"
                                       Margin="0,7,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="UsersCardButton"
                            Click="UsersButton_Click"
                            Style="{StaticResource DashboardCard}"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="👥"
                                       FontSize="28"
                                       Margin="0,0,0,8"/>

                            <TextBlock x:Name="UsersCardTitle"
                                       Text="المستخدمون والصلاحيات"
                                       FontSize="17"
                                       FontWeight="SemiBold"/>

                            <TextBlock x:Name="UsersCardDescription"
                                       Text="إدارة الحسابات والأدوار"
                                       TextWrapping="Wrap"
                                       Margin="0,7,0,0"/>
