<Window x:Class="UniversalPOS.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NexusPOS - الرئيسية"
        Height="780"
        Width="1250"
        MinHeight="650"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F9"
        FlowDirection="RightToLeft"
        Tag="Light">

    <Window.Resources>

        <!-- ComboBox Item Style -->
        <Style x:Key="ThemeComboBoxItemStyle"
               TargetType="{x:Type ComboBoxItem}">

            <Setter Property="Foreground" Value="#17283F"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>

            <Style.Triggers>

                <DataTrigger
                    Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                    Value="Dark">
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="Background" Value="#1F2937"/>
                </DataTrigger>

                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                   Value="Light"/>
                        <Condition Binding="{Binding IsHighlighted, RelativeSource={RelativeSource Self}}"
                                   Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="#17283F"/>
                    <Setter Property="Background" Value="#DBEAFE"/>
                </MultiDataTrigger>

                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                   Value="Dark"/>
                        <Condition Binding="{Binding IsHighlighted, RelativeSource={RelativeSource Self}}"
                                   Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="Background" Value="#374151"/>
                </MultiDataTrigger>

                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                   Value="Light"/>
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}"
                                   Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="#17283F"/>
                    <Setter Property="Background" Value="#BFDBFE"/>
                </MultiDataTrigger>

                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                   Value="Dark"/>
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}"
                                   Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="Background" Value="#374151"/>
                </MultiDataTrigger>

            </Style.Triggers>
        </Style>

        <!-- ComboBox Control Template -->
        <ControlTemplate x:Key="ThemeComboBoxTemplate"
                         TargetType="{x:Type ComboBox}">

            <Grid SnapsToDevicePixels="True">

                <ToggleButton x:Name="DropDownToggle"
                              Focusable="False"
                              ClickMode="Press"
                              IsChecked="{Binding IsDropDownOpen,
                                  Mode=TwoWay,
                                  RelativeSource={RelativeSource TemplatedParent}}"
                              Background="{TemplateBinding Background}"
                              BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}">

                    <ToggleButton.Template>
                        <ControlTemplate TargetType="{x:Type ToggleButton}">

                            <Border x:Name="ToggleBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6"
                                    Padding="8,5">

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                    </Grid.ColumnDefinitions>

                                    <ContentPresenter
                                        Grid.Column="0"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Stretch"
                                        Content="{Binding SelectionBoxItem,
                                            RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                        ContentTemplate="{Binding SelectionBoxItemTemplate,
                                            RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                        ContentTemplateSelector="{Binding ItemTemplateSelector,
                                            RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                        RecognizesAccessKey="True"
                                        TextElement.Foreground="{Binding Foreground,
                                            RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"/>

                                    <Path Grid.Column="1"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Data="M 0 0 L 4 4 L 8 0"
                                          Stroke="{Binding Foreground,
                                              RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                          StrokeThickness="1.5"/>
                                </Grid>
                            </Border>

                            <!-- ComboBox Toggle Hover -->
                            <ControlTemplate.Triggers>

                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ToggleBorder"
                                            Property="BorderBrush"
                                            Value="#93B8E8"/>
                                </Trigger>

                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </Trigger>

                            </ControlTemplate.Triggers>

                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>

                <Popup x:Name="PART_Popup"
                       Placement="Bottom"
                       AllowsTransparency="True"
                       Focusable="False"
                       IsOpen="{Binding IsDropDownOpen,
                           RelativeSource={RelativeSource TemplatedParent}}"
                       PopupAnimation="Fade">

                    <Border Background="{Binding Background,
                                RelativeSource={RelativeSource TemplatedParent}}"
                            BorderBrush="{Binding BorderBrush,
                                RelativeSource={RelativeSource TemplatedParent}}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Margin="0,3,0,0"
                            MinWidth="{Binding ActualWidth,
                                RelativeSource={RelativeSource TemplatedParent}}">

                        <ScrollViewer MaxHeight="250"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">

                            <ItemsPresenter
                                KeyboardNavigation.DirectionalNavigation="Contained"
                                SnapsToDevicePixels="True"/>

                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>

            <ControlTemplate.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5"/>
                </Trigger>
            </ControlTemplate.Triggers>

        </ControlTemplate>

        <!-- ComboBox Style -->
        <Style x:Key="ThemeComboBoxStyle"
               TargetType="{x:Type ComboBox}">

            <Setter Property="Foreground" Value="#17283F"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="MinWidth" Value="125"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ItemContainerStyle"
                    Value="{StaticResource ThemeComboBoxItemStyle}"/>
            <Setter Property="Template"
                    Value="{StaticResource ThemeComboBoxTemplate}"/>

            <Style.Triggers>
                <DataTrigger
                    Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                    Value="Dark">
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                    <Setter Property="Background" Value="#1F2937"/>
                    <Setter Property="BorderBrush" Value="#4B5563"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Sidebar Navigation Buttons -->
        <Style x:Key="NavButton"
               TargetType="{x:Type Button}">

            <Setter Property="Foreground" Value="#E7EDF5"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True"/>
                        </Border>

                        <ControlTemplate.Triggers>

                            <!-- Hover in Light Theme -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                               Value="Light"/>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}"
                                               Value="True"/>
                                </MultiDataTrigger.Conditions>

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#263B55"/>
                                <Setter Property="Foreground"
                                        Value="#FFFFFF"/>
                            </MultiDataTrigger>

                            <!-- Press in Light Theme -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                               Value="Light"/>
                                    <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource TemplatedParent}}"
                                               Value="True"/>
                                </MultiDataTrigger.Conditions>

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#304966"/>
                            </MultiDataTrigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dashboard Cards -->
        <Style x:Key="DashboardCard"
               TargetType="{x:Type Button}">

            <Setter Property="Width" Value="235"/>
            <Setter Property="Height" Value="150"/>
            <Setter Property="Margin" Value="0,0,14,14"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#17283F"/>
            <Setter Property="BorderBrush" Value="#E0E6EF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">

                        <Border x:Name="CardBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">

                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True"
                                TextElement.Foreground="{TemplateBinding Foreground}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <!-- Hover: Light Theme -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                               Value="Light"/>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}"
                                               Value="True"/>
                                </MultiDataTrigger.Conditions>

                                <Setter TargetName="CardBorder"
                                        Property="Background"
                                        Value="#EAF2FC"/>
                                <Setter TargetName="CardBorder"
                                        Property="BorderBrush"
                                        Value="#2563EB"/>
                                <Setter TargetName="CardBorder"
                                        Property="BorderThickness"
                                        Value="2"/>
                            </MultiDataTrigger>

                            <!-- Hover: Dark Theme -->
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                               Value="Dark"/>
                                    <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}"
                                               Value="True"/>
                                </MultiDataTrigger.Conditions>

                                <Setter TargetName="CardBorder"
                                        Property="Background"
                                        Value="#29384D"/>
                                <Setter TargetName="CardBorder"
                                        Property="BorderBrush"
                                        Value="#8AA6CA"/>
                                <Setter TargetName="CardBorder"
                                        Property="BorderThickness"
                                        Value="2"/>
                            </MultiDataTrigger>

                            <!-- Keyboard Focus -->
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="CardBorder"
                                        Property="BorderBrush"
                                        Value="#60A5FA"/>
                            </Trigger>

                            <!-- Disabled -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Metric Cards -->
        <Style x:Key="MetricCard"
               TargetType="{x:Type Border}">

            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E0E6EF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,12,0"/>

        </Style>

    </Window.Resources>

    <Grid x:Name="RootGrid"
          Background="#F3F5F9">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="245"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border x:Name="Sidebar"
                Grid.Column="0"
                Background="#17283F">

            <DockPanel Margin="15">

                <Button x:Name="LogoutButton"
                        DockPanel.Dock="Bottom"
                        Content="تسجيل الخروج"
                        Click="LogoutButton_Click"
                        Style="{StaticResource NavButton}"
                        Margin="0,14,0,4"/>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <TextBlock x:Name="BrandText"
                                   Text="NexusPOS"
                                   FontSize="27"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="8,12,8,4"/>

                        <TextBlock x:Name="BrandSubtitleText"
                                   Text="نظام إدارة نقطة البيع"
                                   Foreground="#B9C7D9"
                                   Margin="8,0,8,24"/>

                        <Button x:Name="HomeButton"
                                Content="الرئيسية"
                                Click="HomeButton_Click"
                                Style="{StaticResource NavButton}"/>

                        <Button x:Name="SalesButton"
                                Content="المبيعات والفواتير"
                                Click="SalesButton_Click"
                                Style="{StaticResource NavButton}"
                                Visibility="Collapsed"/>

                        <Button x:Name="ReturnsButton"
                                Content="المرتجعات"
                                Click="ReturnsButton_Click"
                                Style="{StaticResource NavButton}"
                                Visibility="Collapsed"/>

                        <Button x:Name="ShiftsButton"
                                Content="الورديات والعهدة"
                                Click="ShiftsButton_Click"
                                Style="{StaticResource NavButton}"
                                Visibility="Collapsed"/>

                        <Button x:Name="ProductsButton"
                                Content="المنتجات والتصنيفات"
                                Click="ProductsButton_Click"
                                Style="{StaticResource NavButton}"
                                Visibility="Collapsed"/>

                        <Button x:Name="InventoryButton"
                                Content="المخزون والجرد"
                                Click="InventoryButton_Click"
                                Style="{StaticResource NavButton}"
                                Visibility="Collapsed"/>

                        <Button x:Name="PurchasesButton"
                                Content="المشتريات والموردون"
                                Click="PurchasesButton_Click"
                                Style="{StaticResource NavButton}"
                                Visibility="Collapsed"/>

                        <Button x:Name="ReportsButton"
                                Content="التقارير"
                                Click="ReportsButton_Click"
                                Style="{StaticResource NavButton}"
                                Visibility="Collapsed"/>

                        <Button x:Name="UsersButton"
                                Content="المستخدمون والصلاحيات"
                                Click="UsersButton_Click"
                                Style="{StaticResource NavButton}"
                                Visibility="Collapsed"/>

                        <Button x:Name="PermissionsButton"
                                Content="صلاحياتي"
                                Click="PermissionsButton_Click"
                                Style="{StaticResource NavButton}"/>

                    </StackPanel>
                </ScrollViewer>

            </DockPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Column="1"
              Margin="24">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Bar -->
            <Border x:Name="TopBar"
                    Grid.Row="0"
                    Background="#FFFFFF"
                    BorderBrush="#E0E6EF"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14"
                    Margin="0,0,0,18">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">

                        <TextBlock x:Name="PageTitleText"
                                   Text="لوحة التحكم"
                                   FontSize="25"
                                   FontWeight="Bold"
                                   Foreground="#17283F"/>

                        <TextBlock x:Name="WelcomeText"
                                   Text="أهلاً بك"
                                   FontSize="14"
                                   Margin="0,5,0,0"
                                   Foreground="#52647A"/>

                        <TextBlock x:Name="RoleText"
                                   Text="الدور"
                                   FontSize="12"
                                   Margin="0,4,0,0"
                                   Foreground="#52647A"
                                   TextWrapping="Wrap"/>

                    </StackPanel>

                    <!-- Language and Theme -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                FlowDirection="RightToLeft">

                        <StackPanel Width="135"
                                    Margin="0,0,10,0">

                            <TextBlock x:Name="LanguageLabel"
                                       Text="اللغة"
                                       Foreground="#52647A"
                                       Margin="0,0,0,4"/>

                            <ComboBox x:Name="LanguageComboBox"
                                      Style="{StaticResource ThemeComboBoxStyle}"
                                      SelectedIndex="0"
                                      SelectionChanged="LanguageComboBox_SelectionChanged">

                                <ComboBoxItem Content="العربية" Tag="ar"/>
                                <ComboBoxItem Content="English" Tag="en"/>

                            </ComboBox>

                        </StackPanel>

                        <StackPanel Width="135">

                            <TextBlock x:Name="ThemeLabel"
                                       Text="المظهر"
                                       Foreground="#52647A"
                                       Margin="0,0,0,4"/>

                            <ComboBox x:Name="ThemeComboBox"
                                      Style="{StaticResource ThemeComboBoxStyle}"
                                      SelectedIndex="0"
                                      SelectionChanged="ThemeComboBox_SelectionChanged">

                                <ComboBoxItem Content="فاتح" Tag="Light"/>
                                <ComboBoxItem Content="داكن" Tag="Dark"/>

                            </ComboBox>

                        </StackPanel>

                    </StackPanel>

                </Grid>
            </Border>

            <!-- Overview Metrics -->
            <StackPanel Grid.Row="1"
                        Margin="0,0,0,20">

                <TextBlock x:Name="OverviewTitle"
                           Text="نظرة عامة"
                           FontSize="19"
                           FontWeight="SemiBold"
                           Foreground="#17283F"
                           Margin="0,0,0,12"/>

                <UniformGrid Columns="3">

                    <Border x:Name="SalesMetricCard"
                            Style="{StaticResource MetricCard}">
                        <StackPanel>
                            <TextBlock x:Name="SalesMetricTitle"
                                       Text="مبيعات اليوم"
                                       Foreground="#52647A"/>

                            <TextBlock x:Name="SalesMetricValue"
                                       Text="—"
                                       FontSize="25"
                                       FontWeight="Bold"
                                       Foreground="#2479D8"
                                       Margin="0,8,0,0"/>

                            <TextBlock x:Name="SalesMetricNote"
                                       Text="سيتم ربطها ببيانات المبيعات"
                                       FontSize="11"
                                       Foreground="#7B899B"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="InventoryMetricCard"
                            Style="{StaticResource MetricCard}">
                        <StackPanel>
                            <TextBlock x:Name="InventoryMetricTitle"
                                       Text="المخزون"
                                       Foreground="#52647A"/>

                            <TextBlock x:Name="InventoryMetricValue"
                                       Text="—"
                                       FontSize="25"
                                       FontWeight="Bold"
                                       Foreground="#169B76"
                                       Margin="0,8,0,0"/>

                            <TextBlock x:Name="InventoryMetricNote"
                                       Text="ملخص المخزون"
                                       FontSize="11"
                                       Foreground="#7B899B"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border x:Name="PurchasesMetricCard"
                            Style="{StaticResource MetricCard}">
                        <StackPanel>
                            <TextBlock x:Name="PurchasesMetricTitle"
                                       Text="المشتريات"
                                       Foreground="#52647A"/>

                            <TextBlock x:Name="PurchasesMetricValue"
                                       Text="—"
                                       FontSize="25"
                                       FontWeight="Bold"
                                       Foreground="#B7791F"
                                       Margin="0,8,0,0"/>

                            <TextBlock x:Name="PurchasesMetricNote"
                                       Text="ملخص المشتريات"
                                       FontSize="11"
                                       Foreground="#7B899B"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                </UniformGrid>
            </StackPanel>

            <TextBlock x:Name="SectionsTitle"
                       Grid.Row="2"
                       Text="الأقسام المتاحة لحسابك"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#17283F"
                       Margin="0,0,0,12"/>

            <!-- Dashboard Section Cards -->
            <ScrollViewer Grid.Row="3"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">

                <WrapPanel>

                    <Button x:Name="SalesCardButton"
                            Click="SalesButton_Click"
                            Style="{StaticResource DashboardCard}"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="🛒"
                                       FontSize="28"
                                       Margin="0,0,0,8"/>

                            <TextBlock x:Name="SalesCardTitle"
                                       Text="المبيعات والفواتير"
                                       FontSize="17"
                                       FontWeight="SemiBold"/>

                            <TextBlock x:Name="SalesCardDescription"
                                       Text="إنشاء الفواتير وإتمام البيع"
                                       TextWrapping="Wrap"
                                       Margin="0,7,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="ReturnsCardButton"
                            Click="ReturnsButton_Click"
                            Style="{StaticResource DashboardCard}"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="↩"
                                       FontSize="28"
                                       Margin="0,0,0,8"/>

                            <TextBlock x:Name="ReturnsCardTitle"
                                       Text="المرتجعات"
                                       FontSize="17"
                                       FontWeight="SemiBold"/>

                            <TextBlock x:Name="ReturnsCardDescription"
                                       Text="إدارة مرتجعات البيع"
                                       TextWrapping="Wrap"
                                       Margin="0,7,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="ShiftsCardButton"
                            Click="ShiftsButton_Click"
                            Style="{StaticResource DashboardCard}"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="💰"
                                       FontSize="28"
                                       Margin="0,0,0,8"/>

                            <TextBlock x:Name="ShiftsCardTitle"
                                       Text="الورديات والعهدة"
                                       FontSize="17"
                                       FontWeight="SemiBold"/>

                            <TextBlock x:Name="ShiftsCardDescription"
                                       Text="متابعة النقدية والورديات"
                                       TextWrapping="Wrap"
                                       Margin="0,7,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="ProductsCardButton"
                            Click="ProductsButton_Click"
                            Style="{StaticResource DashboardCard}"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="📦"
                                       FontSize="28"
                                       Margin="0,0,0,8"/>

                            <TextBlock x:Name="ProductsCardTitle"
                                       Text="المنتجات والتصنيفات"
                                       FontSize="17"
                                       FontWeight="SemiBold"/>

                            <TextBlock x:Name="ProductsCardDescription"
                                       Text="إدارة المنتجات والأسعار"
                                       TextWrapping="Wrap"
                                       Margin="0,7,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="InventoryCardButton"
                            Click="InventoryButton_Click"
                            Style="{StaticResource DashboardCard}"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="🏬"
                                       FontSize="28"
                                       Margin="0,0,0,8"/>

                            <TextBlock x:Name="InventoryCardTitle"
                                       Text="المخزون والجرد"
                                       FontSize="17"
                                       FontWeight="SemiBold"/>

                            <TextBlock x:Name="InventoryCardDescription"
                                       Text="متابعة الكميات والحركات"
                                       TextWrapping="Wrap"
                                       Margin="0,7,0,0"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="PurchasesCardButton"
                            Click="PurchasesButton_Click"
                            Style="{StaticResource DashboardCard}"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="🧾"
                                       FontSize="28"
                                       Margin="0,0,0,8"/>

                            <TextBlock x:Name="PurchasesCardTitle"
                                       Text="المشتريات والموردون"
