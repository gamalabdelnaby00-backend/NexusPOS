                                       Text="عرض الصلاحيات الممنوحة لحسابك"
                                       TextWrapping="Wrap"
                                       Margin="0,7,0,0"/>
                        </StackPanel>
                    </Button>

                </WrapPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
