<Application x:Class="UniversalPOS.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Icons.xaml"/>
                <ResourceDictionary Source="Resources/ShellStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <!-- Shared application defaults; AppearanceManager owns runtime palette and direction. -->
        <FontFamily x:Key="NexusPOS.FontFamily">Segoe UI</FontFamily>
        <Thickness x:Key="NexusPOS.ControlPadding">10,6</Thickness>
        <CornerRadius x:Key="NexusPOS.ControlCornerRadius">6</CornerRadius>
        </ResourceDictionary>
    </Application.Resources>
</Application>