<Window x:Class="UniversalPOS.Desktop.Views.StocktakingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="جرد المخزون والتسويات"
        Height="760"
        Width="1200"
        MinHeight="600"
        MinWidth="950"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="#F3F6FC">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#EAF1FF"/>
            <Setter Property="Foreground" Value="#243B5A"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- عنوان الشاشة -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="جرد المخزون والتسويات"
                           FontSize="27"
                           FontWeight="Bold"
                           Foreground="#14243D"/>

                <TextBlock Text="مراجعة الكميات الفعلية ومقارنتها بالكميات المسجلة"
                           Foreground="#687D9A"
                           Margin="0,8,0,0"/>
            </StackPanel>

            <Button Content="إعادة تحميل"
                    DockPanel.Dock="Left"
                    VerticalAlignment="Center"
                    Background="#E8F0FF"
                    Foreground="#1768E8"/>
        </DockPanel>

        <!-- ملخص الجرد -->
        <UniformGrid Grid.Row="1"
                     Columns="4"
                     Margin="0,0,0,18">

            <Border Background="White"
                    CornerRadius="12"
                    Padding="18"
                    Margin="4">
                <StackPanel>
                    <TextBlock Text="إجمالي الأصناف"
                               Foreground="#687D9A"/>
                    <TextBlock x:Name="TotalItemsText"
                               Text="0"
                               FontSize="25"
                               FontWeight="Bold"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="White"
                    CornerRadius="12"
                    Padding="18"
                    Margin="4">
                <StackPanel>
                    <TextBlock Text="الأصناف المطابقة"
                               Foreground="#16814A"/>
                    <TextBlock x:Name="MatchedItemsText"
                               Text="0"
                               FontSize="25"
                               FontWeight="Bold"
                               Foreground="#16814A"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="White"
                    CornerRadius="12"
                    Padding="18"
                    Margin="4">
                <StackPanel>
                    <TextBlock Text="حالات العجز"
                               Foreground="#BD2D2D"/>
                    <TextBlock x:Name="ShortageItemsText"
                               Text="0"
                               FontSize="25"
                               FontWeight="Bold"
                               Foreground="#BD2D2D"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="White"
                    CornerRadius="12"
                    Padding="18"
                    Margin="4">
                <StackPanel>
                    <TextBlock Text="حالات الزيادة"
                               Foreground="#1768E8"/>
                    <TextBlock x:Name="SurplusItemsText"
                               Text="0"
                               FontSize="25"
                               FontWeight="Bold"
                               Foreground="#1768E8"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- البحث والتصفية -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="12"
                Padding="12"
                Margin="0,0,0,12">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchTextBox"
                         Grid.Column="0"
                         Margin="4"
                         ToolTip="ابحث باسم الصنف أو الباركود"/>

                <ComboBox x:Name="FilterComboBox"
                          Grid.Column="1"
                          Margin="4"
                          Padding="8"
                          VerticalContentAlignment="Center"
                          SelectedIndex="0">
                    <ComboBoxItem Content="كل الأصناف"/>
                    <ComboBoxItem Content="الاختلافات فقط"/>
                    <ComboBoxItem Content="الأصناف المطابقة"/>
                    <ComboBoxItem Content="العجز فقط"/>
                    <ComboBoxItem Content="الزيادة فقط"/>
                </ComboBox>
            </Grid>
        </Border>

        <!-- جدول الجرد -->
        <Border Grid.Row="3"
                Background="White"
                CornerRadius="12"
                Padding="10"
                Margin="0,0,0,16">

            <DataGrid x:Name="StocktakingGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="False"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeight="48"
                      AlternatingRowBackground="#F8FAFF"
                      SelectionUnit="FullRow">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="كود الصنف"
                                        Binding="{Binding ItemCode}"
                                        IsReadOnly="True"
                                        Width="*"/>

                    <DataGridTextColumn Header="اسم الصنف"
                                        Binding="{Binding ItemName}"
                                        IsReadOnly="True"
                                        Width="2*"/>

                    <DataGridTextColumn Header="الباركود"
                                        Binding="{Binding Barcode}"
                                        IsReadOnly="True"
                                        Width="*"/>

                    <DataGridTextColumn Header="الكمية المسجلة"
                                        Binding="{Binding RecordedQuantity}"
                                        IsReadOnly="True"
                                        Width="*"/>

                    <DataGridTextColumn Header="الكمية الفعلية"
                                        Binding="{Binding ActualQuantity,
                                            UpdateSourceTrigger=PropertyChanged}"
                                        Width="*"/>

                    <DataGridTextColumn Header="الفرق"
                                        Binding="{Binding Difference}"
                                        IsReadOnly="True"
                                        Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- السبب والإجراءات -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="سبب التسوية"
                           FontWeight="Bold"
                           Margin="4,0"/>

                <TextBox x:Name="ReasonTextBox"
                         ToolTip="اكتب سبب اختلاف الكميات"
                         Margin="4,8,4,4"/>

                <TextBlock x:Name="StatusText"
                           Text="جاهز لبدء الجرد"
                           Foreground="#687D9A"
                           Margin="4,8,4,0"
                           TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Bottom">

                <Button Content="حفظ المسودة"
                        Background="#E8F0FF"
                        Foreground="#1768E8"/>

                <Button Content="اعتماد الجرد"
                        Background="#159B59"
                        Foreground="White"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
