<Window x:Class="UniversalPOS.Desktop.Views.UserAccountsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إدارة حسابات المستخدمين"
        Width="1250"
        Height="780"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterOwner"
        Background="#F4F7FC"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI">

    <Window.Resources>

        <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="TextBrush" Color="#172B4D"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#718096"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#E2E8F0"/>

        <Style x:Key="InputStyle" TargetType="Control">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#DCE5F1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button"
               BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#EDF2FF"/>
            <Setter Property="Foreground" Value="#2457B2"/>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="48"/>
            <Setter Property="ColumnHeaderHeight" Value="44"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EDF1F7"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="AlternationCount" Value="2"/>
            <Setter Property="AlternatingRowBackground" Value="#FAFCFF"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F0F5FC"/>
            <Setter Property="Foreground" Value="#506580"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="White"
                CornerRadius="14"
                Padding="22"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                Margin="0,0,0,16">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="إدارة حسابات المستخدمين"
                               FontSize="25"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"/>

                    <TextBlock Text="إنشاء الحسابات وربطها بالموظفين وإدارة الصلاحيات"
                               FontSize="13"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="0,8,0,0"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="#EAF1FF"
                        CornerRadius="12"
                        Padding="16,10"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="●"
                                   Foreground="#16A36A"
                                   FontSize="14"
                                   Margin="0,0,8,0"/>
                        <TextBlock Text="إدارة آمنة للحسابات"
                                   Foreground="#2457B2"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Create account -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="14"
                Padding="20"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                Margin="0,0,0,16">

            <StackPanel>
                <TextBlock Text="إنشاء حساب دخول جديد"
                           FontSize="17"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}"
                           Margin="0,0,0,14"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="اسم المستخدم"
                                   Margin="4,0,4,2"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <TextBox x:Name="UsernameInput"
                                 Style="{StaticResource InputStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="كلمة المرور"
                                   Margin="4,0,4,2"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <PasswordBox x:Name="PasswordInput"
                                     Style="{StaticResource InputStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="الموظف المرتبط"
                                   Margin="4,0,4,2"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <ComboBox x:Name="EmployeeCombo"
                                  DisplayMemberPath="Name"
                                  Style="{StaticResource InputStyle}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="3">
                        <TextBlock Text="الدور والصلاحية"
                                   Margin="4,0,4,2"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <ComboBox x:Name="RoleCombo"
                                  DisplayMemberPath="Name"
                                  Style="{StaticResource InputStyle}"/>
                    </StackPanel>

                    <Button x:Name="CreateButton"
                            Grid.Column="4"
                            Content="＋ إنشاء الحساب"
                            Style="{StaticResource PrimaryButton}"
                            VerticalAlignment="Bottom"
                            Margin="8,4,4,4"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Accounts table -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="14"
                Padding="20"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                Margin="0,0,0,16">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="حسابات النظام"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="راجع الحسابات وحالتها وآخر تسجيل دخول"
                                   Margin="0,5,0,0"
                                   Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>

                    <Border Grid.Column="1"
                            Background="#F0F5FC"
                            CornerRadius="8"
                            Padding="12,8"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="AccountCountText"
                                   Text="الحسابات"
                                   Foreground="#506580"
                                   FontWeight="SemiBold"/>
                    </Border>
                </Grid>

                <TextBox x:Name="SearchInput"
                         Grid.Row="1"
                         Height="42"
                         Margin="0,0,0,14"
                         Padding="12,8"
                         FontSize="13"
                         Background="#FAFCFF"
                         BorderBrush="#DCE5F1"
                         BorderThickness="1"
                         ToolTip="ابحث باسم المستخدم أو اسم الموظف"/>

                <DataGrid x:Name="AccountsGrid"
                          Grid.Row="2"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          CanUserSortColumns="True">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="رقم"
                                            Binding="{Binding Id}"
                                            Width="60"/>

                        <DataGridTextColumn Header="اسم الدخول"
                                            Binding="{Binding UserName}"
                                            Width="1.1*"/>

                        <DataGridTextColumn Header="الاسم"
                                            Binding="{Binding DisplayName}"
                                            Width="1.3*"/>

                        <DataGridTextColumn Header="الموظف المرتبط"
                                            Binding="{Binding Employee}"
                                            Width="1.3*"/>

                        <DataGridTextColumn Header="الأدوار"
                                            Binding="{Binding Roles}"
                                            Width="1.2*"/>

                        <DataGridTextColumn Header="الحالة"
                                            Binding="{Binding Status}"
                                            Width="100"/>

                        <DataGridTextColumn Header="آخر دخول"
                                            Binding="{Binding LastLogin}"
                                            Width="1.3*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Account actions and status -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <Button x:Name="ToggleButton"
                        Content="تفعيل / تعطيل"
                        Style="{StaticResource SecondaryButton}"/>

                <Button x:Name="ChangeRoleButton"
                        Content="تغيير الدور"
                        Style="{StaticResource SecondaryButton}"/>

                <Button x:Name="ResetPasswordButton"
                        Content="إعادة تعيين كلمة المرور"
                        Style="{StaticResource SecondaryButton}"/>
            </StackPanel>

            <Border Grid.Column="1"
                    Background="#EAF7F0"
                    CornerRadius="9"
                    Padding="12,8"
                    Margin="8,4,0,4"
                    VerticalAlignment="Center">
                <TextBlock x:Name="StatusText"
                           Text="جاهز"
                           Foreground="#19734A"
                           TextWrapping="Wrap"
                           FontSize="12"/>
            </Border>
        </Grid>
    </Grid>
</Window>