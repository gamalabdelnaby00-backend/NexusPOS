<Window x:Class="UniversalPOS.Desktop.Views.ProductEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NexusPOS | Product" Width="800" Height="730" MinWidth="680" MinHeight="620"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="#F3F7FC" FontFamily="Segoe UI" FlowDirection="RightToLeft">
  <Window.Resources>
    <SolidColorBrush x:Key="Navy" Color="#142B48"/><SolidColorBrush x:Key="Blue" Color="#1669E8"/><SolidColorBrush x:Key="FieldBorder" Color="#D7E0ED"/>
    <Style TargetType="TextBox"><Setter Property="Height" Value="40"/><Setter Property="Padding" Value="10,5"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="BorderBrush" Value="{StaticResource FieldBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="White"/><Setter Property="FontSize" Value="13"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Height" Value="40"/><Setter Property="Padding" Value="8,4"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="BorderBrush" Value="{StaticResource FieldBorder}"/><Setter Property="Background" Value="White"/></Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Navy}"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,7"/></Style>
  </Window.Resources>
  <DockPanel LastChildFill="True">
    <Border DockPanel.Dock="Top" Background="White" Padding="26,20" BorderBrush="#D7E0ED" BorderThickness="0,0,0,1">
      <StackPanel><TextBlock x:Name="HeaderTitle" FontSize="24" FontWeight="Bold" Foreground="#142B48"/><TextBlock x:Name="HeaderSubtitle" FontSize="12" Foreground="#68788D" Margin="0,6,0,0"/></StackPanel>
    </Border>
    <Border DockPanel.Dock="Bottom" Background="White" Padding="24,14" BorderBrush="#D7E0ED" BorderThickness="0,1,0,0">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel x:Name="OpeningPanel" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="OpeningLabel" VerticalAlignment="Center" Foreground="#142B48" Margin="0,0,10,0"/><TextBox x:Name="OpeningTextBox" Width="110" Text="0"/></StackPanel>
        <TextBlock x:Name="ExistingStockText" Text="رصيد المخزون لن يتغير" VerticalAlignment="Center" Foreground="#142B48" Visibility="Collapsed"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="CancelButton" Content="إلغاء" MinWidth="100" Height="40" Margin="0,0,10,0" Background="White" Foreground="#142B48" BorderBrush="#D7E0ED" Click="Cancel_Click"/><Button x:Name="SaveButton" Content="حفظ المنتج" MinWidth="130" Height="40" Padding="14,0" Background="#1669E8" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Click="Save_Click"/></StackPanel>
      </Grid>
    </Border>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26,20,26,16">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,16"><TextBlock x:Name="NameLabel" Text="اسم المنتج *" Style="{StaticResource FieldLabel}"/><TextBox x:Name="NameTextBox" ToolTip="اسم المنتج"/></StackPanel>
        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,16"><TextBlock x:Name="CodeLabel" Text="كود المنتج *" Style="{StaticResource FieldLabel}"/><TextBox x:Name="CodeTextBox" ToolTip="يجب أن يكون الكود فريدًا"/></StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,16"><TextBlock x:Name="BarcodeLabel" Text="الباركود *" Style="{StaticResource FieldLabel}"/><TextBox x:Name="BarcodeTextBox" ToolTip="يجب أن يكون الباركود فريدًا"/></StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,16"><TextBlock x:Name="CategoryLabel" Text="التصنيف *" Style="{StaticResource FieldLabel}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="CategoryComboBox" Margin="0,0,8,0"/><Button x:Name="AddCategoryButton" Content="+ تصنيف" Grid.Column="1" Height="40" Padding="10,0" Background="White" Foreground="#1669E8" BorderBrush="#D7E0ED" Click="AddCategory_Click"/></Grid></StackPanel>
        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,16"><TextBlock x:Name="SellingPriceLabel" Text="سعر البيع *" Style="{StaticResource FieldLabel}"/><TextBox x:Name="PriceTextBox" Text="0.00"/></StackPanel>
        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,16"><TextBlock x:Name="CostPriceLabel" Text="سعر التكلفة" Style="{StaticResource FieldLabel}"/><TextBox x:Name="CostTextBox" Text="0.00"/></StackPanel>
        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,0,16"><TextBlock x:Name="MinimumLabel" Text="حد إعادة الطلب" Style="{StaticResource FieldLabel}"/><TextBox x:Name="MinimumTextBox" Text="0"/></StackPanel>
        <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,0,0,16"><TextBlock x:Name="UnitLabelText" Text="وحدة القياس" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="UnitComboBox"/></StackPanel>
        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,0,0,12"><TextBlock x:Name="ImageLabel" Text="صورة المنتج (اختياري)" Style="{StaticResource FieldLabel}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button x:Name="ChooseImageButton" Content="اختيار صورة" Height="38" Padding="12,0" Margin="0,0,10,0" Background="White" Foreground="#1669E8" BorderBrush="#D7E0ED" Click="ChooseImage_Click"/><TextBlock x:Name="ImageNameText" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></Grid></StackPanel>
      </Grid>
    </ScrollViewer>
  </DockPanel>
</Window>