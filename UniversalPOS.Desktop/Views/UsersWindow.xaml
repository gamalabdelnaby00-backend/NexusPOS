<Window x:Class="UniversalPOS.Desktop.Views.UsersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="الموظفون"
        Width="1100"
        Height="700"
        MinWidth="850"
        MinHeight="550"
        WindowStartupLocation="CenterScreen"
        Background="#F4F7FC"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#1768E8"/>
        <SolidColorBrush x:Key="TextBrush" Color="#172B4D"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#71829A"/>
        <SolidColorBrush x:Key="BorderBrushColor" Color="#E0E8F3"/>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#EAF1FF"/>
            <Setter Property="Foreground" Value="#1754AA"/>
        </Style>

        <Style x:Key="SearchBox" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#DCE5F1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="DataGridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5FB"/>
            <Setter Property="Foreground" Value="#536985"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,14"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#E0E8F3"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock x:Name="TitleText"
                           Text="الموظفون"
                           FontSize="27"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}"/>

                <TextBlock x:Name="SubtitleText"
                           Text="إدارة بيانات الموظفين وحالة الحساب"
                           FontSize="13"
                           Margin="0,6,0,0"
                           Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                <Button x:Name="AccountsButton"
                        Content="حسابات المستخدمين"
                        Style="{StaticResource ActionButton}"/>

                <Button x:Name="AddButton"
                        Content="+ إضافة موظف"
                        Background="{StaticResource PrimaryBrush}"
                        Foreground="White"
                        Style="{StaticResource ActionButton}"/>
            </StackPanel>
        </Grid>

        <!-- Search -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="{StaticResource BorderBrushColor}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12"
                Margin="0,0,0,16">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="4">
                    <TextBlock Text="كود الموظف"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="5,0,5,2"/>

                    <TextBox x:Name="CodeSearchBox"
                             Style="{StaticResource SearchBox}"
                             ToolTip="ابحث بكود الموظف"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="4">
                    <TextBlock Text="اسم الموظف"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="5,0,5,2"/>

                    <TextBox x:Name="NameSearchBox"
                             Style="{StaticResource SearchBox}"
                             ToolTip="ابحث باسم الموظف"/>
                </StackPanel>

                <Button x:Name="ClearSearchButton"
                        Grid.Column="2"
                        Content="مسح البحث"
                        VerticalAlignment="Bottom"
                        Height="40"
                        Style="{StaticResource ActionButton}"/>
            </Grid>
        </Border>

        <!-- Employees Table -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="{StaticResource BorderBrushColor}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="8">

            <DataGrid x:Name="EmployeesGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#EDF1F7"
                      Background="White"
                      BorderThickness="0"
                      RowHeight="52"
                      ColumnHeaderHeight="46"
                      FontSize="13">

                <DataGrid.ColumnHeaderStyle>
                    <StaticResource ResourceKey="DataGridHeader"/>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn x:Name="CodeColumn"
                                        Header="كود الموظف"
                                        Binding="{Binding Code}"
                                        Width="1.2*"/>

                    <DataGridTextColumn x:Name="FullNameColumn"
                                        Header="الاسم الكامل"
                                        Binding="{Binding FullName}"
                                        Width="3.4*"/>

                    <DataGridTextColumn x:Name="JobTitleColumn"
                                        Header="المسمى الوظيفي"
                                        Binding="{Binding JobTitle}"
                                        Width="1.4*"/>

                    <DataGridCheckBoxColumn x:Name="ActiveColumn"
                                            Header="نشط"
                                            Binding="{Binding IsActive}"
                                            Width="0.7*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer Actions -->
        <Border Grid.Row="3"
                Background="White"
                BorderBrush="{StaticResource BorderBrushColor}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="10"
                Margin="0,16,0,0">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText"
                           Text="اختر موظفًا لتنفيذ إجراء"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}"
                           Margin="8"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">

                    <Button x:Name="DetailsButton"
                            Content="عرض التفاصيل"
                            Style="{StaticResource ActionButton}"/>

                    <Button x:Name="ToggleActiveButton"
                            Content="تغيير حالة الموظف"
                            Style="{StaticResource ActionButton}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
