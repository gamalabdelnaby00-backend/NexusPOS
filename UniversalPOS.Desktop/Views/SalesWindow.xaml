<Window x:Class="UniversalPOS.Desktop.Views.SalesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:UniversalPOS.Desktop.Views"
        Title="{x:Static v:SalesText.WindowTitle}" Width="1500" Height="900" MinWidth="1200" MinHeight="720"
        WindowStartupLocation="CenterOwner" WindowState="Maximized"
        Background="#EAF1FA" FontFamily="Segoe UI" FlowDirection="RightToLeft">

    <Window.Resources>
        <!-- Icons (self-contained so this window does not depend on any other resource file) -->
        <Geometry x:Key="SIcon.Cart">M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z</Geometry>
        <Geometry x:Key="SIcon.Search">M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z</Geometry>
        <Geometry x:Key="SIcon.Plus">M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z</Geometry>
        <Geometry x:Key="SIcon.Minus">M19 13H5v-2h14v2z</Geometry>
        <Geometry x:Key="SIcon.Barcode">M2 5h2v14H2zM6 5h1v14H6zM9 5h3v14H9zM14 5h1v14h-1zM17 5h2v14h-2zM21 5h1v14h-1z</Geometry>
        <Geometry x:Key="SIcon.Delete">M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z</Geometry>
        <Geometry x:Key="SIcon.Check">M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z</Geometry>
        <Geometry x:Key="SIcon.Bell">M12 22c1.1 0 2-.9 2-2h-4c0 1.1.89 2 2 2zm6-6v-5c0-3.07-1.64-5.64-4.5-6.32V4c0-.83-.67-1.5-1.5-1.5s-1.5.67-1.5 1.5v.68C7.63 5.36 6 7.92 6 11v5l-2 2v1h16v-1l-2-2z</Geometry>
        <Geometry x:Key="SIcon.Account">M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z</Geometry>
        <Geometry x:Key="SIcon.Calendar">M19 3h-1V1h-2v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11zM7 10h5v5H7z</Geometry>
        <Geometry x:Key="SIcon.Grid">M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z</Geometry>
        <Geometry x:Key="SIcon.Category">M12 2l-5.5 9h11zM17.5 13c-2.49 0-4.5 2.01-4.5 4.5s2.01 4.5 4.5 4.5 4.5-2.01 4.5-4.5-2.01-4.5-4.5-4.5zM3 21.5h8v-8H3v8z</Geometry>
        <Geometry x:Key="SIcon.Printer">M19 8H5c-1.66 0-3 1.34-3 3v6h4v4h12v-4h4v-6c0-1.66-1.34-3-3-3zm-3 11H8v-5h8v5zm3-7c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1zm-1-9H6v4h12V3z</Geometry>
        <Geometry x:Key="SIcon.Refresh">M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z</Geometry>
        <Geometry x:Key="SIcon.Cash">M2 6h20v12H2V6zm10 9.5c1.93 0 3.5-1.57 3.5-3.5S13.93 8.5 12 8.5 8.5 10.07 8.5 12s1.57 3.5 3.5 3.5z</Geometry>
        <Geometry x:Key="SIcon.Card">M20 4H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2zm0 14H4v-6h16v6zm0-10H4V6h16v2z</Geometry>
        <Geometry x:Key="SIcon.Wallet">M21 18v1c0 1.1-.9 2-2 2H5c-1.11 0-2-.9-2-2V5c0-1.1.89-2 2-2h14c1.1 0 2 .9 2 2v1h-9c-1.11 0-2 .9-2 2v8c0 1.1.89 2 2 2h9zm-9-2h10V8H12v8zm4-2.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z</Geometry>
        <Geometry x:Key="SIcon.Bolt">M7 2v11h3v9l7-12h-4l4-8z</Geometry>
        <Geometry x:Key="SIcon.Box">M21 16.5c0 .38-.21.71-.53.88l-7.9 4.44c-.16.12-.36.18-.57.18s-.41-.06-.57-.18l-7.9-4.44A.991.991 0 0 1 3 16.5v-9c0-.38.21-.71.53-.88l7.9-4.44c.16-.12.36-.18.57-.18s.41.06.57.18l7.9 4.44c.32.17.53.5.53.88v9zM12 4.15L6.04 7.5 12 10.85l5.96-3.35L12 4.15zM5 15.91l6 3.38v-6.71L5 9.21v6.7zm14 0v-6.7l-6 3.37v6.71l5.97-3.38z</Geometry>

        <SolidColorBrush x:Key="Ink" Color="#12294A"/>
        <SolidColorBrush x:Key="Muted" Color="#5F7390"/>
        <SolidColorBrush x:Key="Blue" Color="#0A74F0"/>
        <SolidColorBrush x:Key="CardBorder" Color="#D2E2F5"/>
        <SolidColorBrush x:Key="Line" Color="#E1EAF5"/>

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="RoundButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.88"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProductCardButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Background="White" BorderBrush="#DCE6F3" BorderThickness="1" Padding="10,8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#0A74F0"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.55"/><Setter TargetName="Bd" Property="Background" Value="#F4F7FB"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QtyButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Background="#EAF2FD" BorderBrush="#C9DCF5" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#D5E6FB"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PaymentButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="82"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="10" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="8,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.9"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PagerButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Margin" Value="3,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FilterCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="MinWidth" Value="170"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#C9D9EC"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <DataTemplate x:Key="CartRowTemplate">
            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" MinHeight="52">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="116"/>
                        <ColumnDefinition Width="74"/>
                        <ColumnDefinition Width="78"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Index}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Ink}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold"
                               Foreground="{StaticResource Ink}" Margin="4,0"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- + increases the quantity of this product on the invoice -->
                        <Button Style="{StaticResource QtyButton}" Tag="{Binding}" Click="IncreaseQuantity_Click" ToolTip="{x:Static v:SalesText.Increase}">
                            <Path Data="{StaticResource SIcon.Plus}" Fill="#0A5FCC" Width="14" Height="14" Stretch="Uniform"/>
                        </Button>
                        <TextBlock Text="{Binding QuantityText}" MinWidth="30" TextAlignment="Center" VerticalAlignment="Center"
                                   FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="4,0"/>
                        <Button Style="{StaticResource QtyButton}" Tag="{Binding}" Click="DecreaseQuantity_Click" ToolTip="{x:Static v:SalesText.Decrease}">
                            <Path Data="{StaticResource SIcon.Minus}" Fill="#0A5FCC" Width="14" Height="14" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                    <TextBlock Grid.Column="3" Text="{Binding UnitPrice, StringFormat=N2}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Ink}"/>
                    <TextBlock Grid.Column="4" Text="{Binding Total, StringFormat=N2}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                    <Button Grid.Column="5" Tag="{Binding}" Click="RemoveCartItem_Click" Background="Transparent" BorderThickness="0" Cursor="Hand"
                            HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="{x:Static v:SalesText.RemoveFromInvoice}">
                        <Path Data="{StaticResource SIcon.Delete}" Fill="#E0443E" Width="18" Height="18" Stretch="Uniform"/>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ProductCardTemplate">
            <Button Style="{StaticResource ProductCardButton}" Tag="{Binding}" Click="AddProduct_Click" IsEnabled="{Binding InStock}" Margin="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="104"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding Name}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="38" MinHeight="38"
                               FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Ink}" HorizontalAlignment="Center" TextAlignment="Center"/>
                    <Grid Grid.Row="1" Margin="0,6">
                        <Path Data="{StaticResource SIcon.Box}" Fill="#B7C8E0" Width="46" Height="46" Stretch="Uniform"
                              Visibility="{Binding PlaceholderVisibility}"/>
                        <Image Source="{Binding ImageSource}" Stretch="Uniform"/>
                    </Grid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,4">
                        <Path Data="{StaticResource SIcon.Check}" Fill="{Binding StockBrush}" Width="14" Height="14" Stretch="Uniform"
                              VerticalAlignment="Center" Visibility="{Binding InStockVisibility}"/>
                        <TextBlock Text="{Binding StockText}" Foreground="{Binding StockBrush}" FontSize="12" FontWeight="SemiBold" Margin="5,0,0,0" VerticalAlignment="Center"/>
                        <Border Background="#DDF3E3" BorderBrush="#BFE5C9" BorderThickness="1" CornerRadius="9" Padding="7,1" Margin="8,0,0,0"
                                VerticalAlignment="Center" Visibility="{Binding InStockVisibility}">
                            <TextBlock Text="In stock" Foreground="#2B7A43" FontSize="10.5" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Grid.Row="3" Text="{Binding Price, StringFormat=N2}" FontSize="17" FontWeight="Bold" Foreground="#0B5FCC" HorizontalAlignment="Center"/>
                </Grid>
            </Button>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: signed-in user -->
        <Border Grid.Row="0" Background="White" BorderBrush="#D8E4F3" BorderThickness="0,0,0,1" Padding="26,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                <Border Width="42" Height="42" CornerRadius="21" Background="#0A74F0">
                    <Path Data="{StaticResource SIcon.Account}" Fill="White" Width="26" Height="26" Stretch="Uniform"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="CashierNameText" FontSize="15" FontWeight="Bold" Foreground="{StaticResource Ink}"/>
                    <TextBlock x:Name="CashierRoleText" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                </StackPanel>
                <Path Data="{StaticResource SIcon.Bell}" Fill="#0A74F0" Width="22" Height="22" Stretch="Uniform" Margin="24,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Title row -->
        <Grid Grid.Row="1" Margin="28,18,28,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Path Data="{StaticResource SIcon.Cart}" Fill="#0B4FB3" Width="32" Height="32" Stretch="Uniform"/>
                <TextBlock Text="{x:Static v:SalesText.SalesTitle}" FontSize="28" FontWeight="Bold" Foreground="#0B4FB3" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <Border HorizontalAlignment="Right" Background="White" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="14,8">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{StaticResource SIcon.Calendar}" Fill="#0A74F0" Width="20" Height="20" Stretch="Uniform"/>
                    <TextBlock x:Name="DateText" Margin="10,0,0,0" FontSize="13" Foreground="{StaticResource Ink}" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Toolbar -->
        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}" Margin="28,0,28,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="AddManualButton" Grid.Column="0" Style="{StaticResource RoundButton}" Background="#0A74F0" BorderBrush="#0A74F0"
                        Foreground="White" Click="AddManualProduct_Click" Padding="22,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource SIcon.Plus}" Fill="White" Width="18" Height="18" Stretch="Uniform"/>
                        <TextBlock Text="{x:Static v:SalesText.AddManual}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ScanButton" Grid.Column="1" Style="{StaticResource RoundButton}" Background="#0A74F0" BorderBrush="#0A74F0"
                        Foreground="White" Click="ScanBarcode_Click" Margin="12,0,0,0" Padding="22,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource SIcon.Barcode}" Fill="White" Width="20" Height="20" Stretch="Uniform"/>
                        <TextBlock Text="{x:Static v:SalesText.ScanBarcode}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <ComboBox x:Name="SectionComboBox" Grid.Column="2" Style="{StaticResource FilterCombo}" Margin="12,0,0,0"
                          SelectionChanged="SectionComboBox_SelectionChanged"/>
                <ComboBox x:Name="AvailabilityComboBox" Grid.Column="3" Style="{StaticResource FilterCombo}" Margin="12,0,0,0"
                          SelectionChanged="AvailabilityComboBox_SelectionChanged">
                    <ComboBoxItem Content="{x:Static v:SalesText.AllStatuses}" IsSelected="True"/>
                    <ComboBoxItem Content="{x:Static v:SalesText.Available}"/>
                    <ComboBoxItem Content="{x:Static v:SalesText.OutOfStockShort}"/>
                </ComboBox>
                <Border Grid.Column="4" Height="44" Margin="12,0,0,0" Background="White" BorderBrush="#C9D9EC" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Path Data="{StaticResource SIcon.Search}" Fill="#5F7390" Width="20" Height="20" Stretch="Uniform" Margin="12,0,6,0"/>
                        <Grid Grid.Column="1">
                            <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent" FontSize="13" Padding="4,0"
                                     VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"/>
                            <TextBlock x:Name="SearchHint" Text="{x:Static v:SalesText.SearchHint}" Foreground="#7C8DA6" FontSize="13"
                                       IsHitTestVisible="False" VerticalAlignment="Center" Margin="4,0"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Main area: invoice items | products | categories -->
        <Grid Grid.Row="3" Margin="28,0,28,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="500"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="240"/>
            </Grid.ColumnDefinitions>

            <!-- Invoice items -->
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Path Data="{StaticResource SIcon.Cart}" Fill="#0B5FCC" Width="22" Height="22" Stretch="Uniform"/>
                            <TextBlock Text="{x:Static v:SalesText.InvoiceItems}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Ink}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="ReceiptNumberText" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Muted}"/>
                    </Grid>
                    <Border Grid.Row="1" Background="#EEF3F9" CornerRadius="6" Padding="0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="116"/>
                                <ColumnDefinition Width="74"/>
                                <ColumnDefinition Width="78"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="#" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                            <TextBlock Grid.Column="1" Text="{x:Static v:SalesText.ColProduct}" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="4,0"/>
                            <TextBlock Grid.Column="2" Text="{x:Static v:SalesText.ColQuantity}" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                            <TextBlock Grid.Column="3" Text="{x:Static v:SalesText.ColUnitPrice}" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                            <TextBlock Grid.Column="4" Text="{x:Static v:SalesText.ColTotal}" HorizontalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="CartItems" ItemTemplate="{StaticResource CartRowTemplate}"/>
                        </ScrollViewer>
                        <TextBlock x:Name="EmptyCartText" Text="{x:Static v:SalesText.EmptyCart}" Foreground="{StaticResource Muted}" FontSize="13"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <Border Grid.Row="3" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,10,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static v:SalesText.Subtotal}" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,5"/>
                            <TextBlock x:Name="SubtotalText" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Text="0.00" Foreground="{StaticResource Ink}" Margin="0,5" HorizontalAlignment="Right"/>

                            <!-- The discount is set by a manager from another screen; the cashier only sees it (zero by default). -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static v:SalesText.Discount}" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,5" VerticalAlignment="Center"/>
                            <Border Grid.Row="1" Grid.Column="1" Width="110" Height="30" Background="#F2F6FB" BorderBrush="#D2E2F5" BorderThickness="1" CornerRadius="6" Margin="0,3,12,3">
                                <TextBlock x:Name="DiscountPercentText" Text="0%" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                            </Border>
                            <TextBlock x:Name="DiscountText" Grid.Row="1" Grid.Column="2" Text="0.00" Foreground="{StaticResource Ink}" Margin="0,5" MinWidth="70" VerticalAlignment="Center"/>

                            <TextBlock x:Name="VatLabelText" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="{x:Static v:SalesText.Tax}" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,5"/>
                            <TextBlock x:Name="VatText" Grid.Row="2" Grid.Column="2" Text="0.00" Foreground="{StaticResource Ink}" Margin="0,5" MinWidth="70"/>

                            <Border Grid.Row="3" Grid.ColumnSpan="3" Background="#DCEBFC" BorderBrush="#BBD3F2" BorderThickness="1" CornerRadius="8" Padding="16,10" Margin="0,8,0,0">
                                <Grid>
                                    <TextBlock Text="{x:Static v:SalesText.GrandTotal}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Ink}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TotalText" Text="0.00" FontSize="24" FontWeight="Bold" Foreground="#0B2A4F" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Products (hidden until the user asks to display them) -->
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="12,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBlock Text="{x:Static v:SalesText.Products}" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Ink}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ProductsCountText" FontSize="12" Foreground="{StaticResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button x:Name="ShowProductsButton" HorizontalAlignment="Right" Style="{StaticResource RoundButton}" Height="36"
                                Background="#EAF2FD" BorderBrush="#C9DCF5" Foreground="#0B4FB3" Click="ShowProducts_Click" Padding="16,0"/>
                    </Grid>

                    <Grid Grid.Row="1">
                        <ScrollViewer x:Name="ProductsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                            <ItemsControl x:Name="ProductsItems" ItemTemplate="{StaticResource ProductCardTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="4"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                        <StackPanel x:Name="ProductsEmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="{StaticResource SIcon.Box}" Fill="#B7C8E0" Width="64" Height="64" Stretch="Uniform" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="ProductsEmptyText" Text="{x:Static v:SalesText.ProductsHidden}"
                                       Foreground="{StaticResource Muted}" FontSize="14" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel x:Name="PagerPanel" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" FlowDirection="LeftToRight" Margin="0,10,0,0"/>
                </Grid>
            </Border>

            <!-- Categories -->
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Margin="12,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Path Data="{StaticResource SIcon.Grid}" Fill="#0A74F0" Width="22" Height="22" Stretch="Uniform"/>
                        <TextBlock Text="{x:Static v:SalesText.Categories}" FontSize="16" FontWeight="Bold" Foreground="#0B5FCC" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="CategoriesPanel"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom bar: payment -->
        <Border Grid.Row="4" Style="{StaticResource CardBorderStyle}" Margin="28,0,28,18" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource RoundButton}" Height="82" MinWidth="190" Background="#1FA257" BorderBrush="#1FA257"
                        Foreground="White" FontSize="16" Click="CompletePayment_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource SIcon.Check}" Fill="White" Width="22" Height="22" Stretch="Uniform"/>
                        <TextBlock Text="{x:Static v:SalesText.CompleteSale}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <StackPanel Grid.Column="1" Margin="16,0">
                    <TextBlock Text="{x:Static v:SalesText.PaymentMethodLabel}" FontSize="11" Foreground="#8A9AB0" Margin="6,0,0,4"/>
                    <UniformGrid Rows="1" Columns="4">
                        <Button x:Name="CashButton" Style="{StaticResource PaymentButton}" Tag="Cash" Click="PaymentMethod_Click" Background="#EAF4FF" BorderBrush="#0A74F0" BorderThickness="2">
                            <Grid>
                                <StackPanel HorizontalAlignment="Center">
                                    <Path Data="{StaticResource SIcon.Cash}" Fill="#2E9D5F" Width="30" Height="30" Stretch="Uniform"/>
                                    <TextBlock Text="{x:Static v:SalesText.Cash}" FontWeight="SemiBold" Foreground="{StaticResource Ink}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Border x:Name="CashCheck" Width="20" Height="20" CornerRadius="10" Background="#0A74F0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-4,-8,-4,0">
                                    <Path Data="{StaticResource SIcon.Check}" Fill="White" Width="12" Height="12" Stretch="Uniform"/>
                                </Border>
                            </Grid>
                        </Button>
                        <Button x:Name="CardButton" Style="{StaticResource PaymentButton}" Tag="Card" Click="PaymentMethod_Click" Background="White" BorderBrush="#D6E0EC" BorderThickness="1">
                            <Grid>
                                <StackPanel HorizontalAlignment="Center">
                                    <Path Data="{StaticResource SIcon.Card}" Fill="#16A5A5" Width="30" Height="30" Stretch="Uniform"/>
                                    <TextBlock Text="{x:Static v:SalesText.Card}" FontWeight="SemiBold" Foreground="{StaticResource Ink}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Border x:Name="CardCheck" Width="20" Height="20" CornerRadius="10" Background="#0A74F0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-4,-8,-4,0" Visibility="Collapsed">
                                    <Path Data="{StaticResource SIcon.Check}" Fill="White" Width="12" Height="12" Stretch="Uniform"/>
                                </Border>
                            </Grid>
                        </Button>
                        <Button x:Name="InstaPayButton" Style="{StaticResource PaymentButton}" Tag="InstaPay" Click="PaymentMethod_Click" Background="White" BorderBrush="#D6E0EC" BorderThickness="1">
                            <Grid>
                                <StackPanel HorizontalAlignment="Center">
                                    <Path Data="{StaticResource SIcon.Bolt}" Fill="#7B3FCB" Width="30" Height="30" Stretch="Uniform"/>
                                    <TextBlock Text="{x:Static v:SalesText.InstaPay}" FontWeight="SemiBold" Foreground="{StaticResource Ink}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Border x:Name="InstaPayCheck" Width="20" Height="20" CornerRadius="10" Background="#0A74F0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-4,-8,-4,0" Visibility="Collapsed">
                                    <Path Data="{StaticResource SIcon.Check}" Fill="White" Width="12" Height="12" Stretch="Uniform"/>
                                </Border>
                            </Grid>
                        </Button>
                        <Button x:Name="EWalletButton" Style="{StaticResource PaymentButton}" Tag="EWallet" Click="PaymentMethod_Click" Background="White" BorderBrush="#D6E0EC" BorderThickness="1">
                            <Grid>
                                <StackPanel HorizontalAlignment="Center">
                                    <Path Data="{StaticResource SIcon.Wallet}" Fill="#E08A12" Width="30" Height="30" Stretch="Uniform"/>
                                    <TextBlock Text="{x:Static v:SalesText.EWallet}" FontWeight="SemiBold" Foreground="{StaticResource Ink}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Border x:Name="EWalletCheck" Width="20" Height="20" CornerRadius="10" Background="#0A74F0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-4,-8,-4,0" Visibility="Collapsed">
                                    <Path Data="{StaticResource SIcon.Check}" Fill="White" Width="12" Height="12" Stretch="Uniform"/>
                                </Border>
                            </Grid>
                        </Button>
                    </UniformGrid>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Style="{StaticResource RoundButton}" Height="82" MinWidth="120" Background="#FDE6E6" BorderBrush="#F3B7B7" Foreground="#C23B3B" Click="ClearCart_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource SIcon.Delete}" Fill="#C23B3B" Width="20" Height="20" Stretch="Uniform"/>
                            <TextBlock Text="{x:Static v:SalesText.ClearCart}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource RoundButton}" Height="82" MinWidth="100" Margin="10,0,0,0" Background="#E9EEF5" BorderBrush="#CBD6E4" Foreground="#12294A" Click="CancelSale_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource SIcon.Refresh}" Fill="#12294A" Width="20" Height="20" Stretch="Uniform"/>
                            <TextBlock Text="{x:Static v:SalesText.CancelButton}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource RoundButton}" Height="82" MinWidth="110" Margin="10,0,0,0" Background="White" BorderBrush="#C9D9EC" Foreground="#12294A" Click="SplitPayment_Click">
                        <TextBlock Text="{x:Static v:SalesText.SplitPayment}" VerticalAlignment="Center"/>
                    </Button>
                    <Button Style="{StaticResource RoundButton}" Height="82" MinWidth="150" Margin="10,0,0,0" Background="#0A74F0" BorderBrush="#0A74F0" Foreground="White" Click="PrintInvoice_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource SIcon.Printer}" Fill="White" Width="22" Height="22" Stretch="Uniform"/>
                            <TextBlock Text="{x:Static v:SalesText.PrintInvoice}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
