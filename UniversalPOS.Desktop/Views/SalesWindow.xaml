<Window x:Class="UniversalPOS.Desktop.Views.SalesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RetailPOS - New Sale"
        Width="1440"
        Height="900"
        MinWidth="1150"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#F3F5F7"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="Blue" Color="#078BC5"/>
        <SolidColorBrush x:Key="TextColor" Color="#202B36"/>
        <SolidColorBrush x:Key="Muted" Color="#788592"/>
        <SolidColorBrush x:Key="BorderColor" Color="#E6EBF0"/>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,3"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#465361"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CategoryButton" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#475563"/>
            <Setter Property="BorderBrush" Value="#E5EAF0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SmallActionButton" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="0,0,7,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#4B5865"/>
            <Setter Property="BorderBrush" Value="#E4E9EE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ProductCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#EDF0F3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Margin" Value="0,0,10,10"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style x:Key="PaymentButton" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,0,5,5"/>
            <Setter Property="Foreground" Value="#344353"/>
            <Setter Property="Background" Value="#E9EDF2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="205"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SIDEBAR -->
        <Border Grid.Column="0"
                Background="White"
                BorderBrush="#E8EDF1"
                BorderThickness="0,0,1,0">

            <Grid Margin="13,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="65"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="78"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Width="25"
                            Height="25"
                            CornerRadius="5"
                            Background="#0795CC">
                        <TextBlock Text="▦"
                                   Foreground="White"
                                   FontSize="16"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="RetailPOS"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="#172432"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,14,0,0">
                    <Button Style="{StaticResource NavButton}"
                            Content="⌂   Dashboard"/>

                    <Button Style="{StaticResource NavButton}"
                            Content="▦   New Sale"
                            Background="#EAF6FC"
                            Foreground="#078BC5"
                            FontWeight="SemiBold"/>

                    <Button Style="{StaticResource NavButton}"
                            Content="▤   Inventory"/>

                    <Button Style="{StaticResource NavButton}"
                            Content="♙   Customers"/>

                    <Button Style="{StaticResource NavButton}"
                            Content="▧   Reports"/>

                    <Button Style="{StaticResource NavButton}"
                            Content="⚙   Settings"/>
                </StackPanel>

                <StackPanel Grid.Row="2"
                            VerticalAlignment="Center">
                    <Border Height="1"
                            Background="#EDF0F3"
                            Margin="0,0,0,12"/>

                    <StackPanel Orientation="Horizontal">
                        <Border Width="29"
                                Height="29"
                                CornerRadius="15"
                                Background="#E7EDF2">
                            <TextBlock Text="MA"
                                       FontSize="9"
                                       Foreground="#455668"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="CashierNameText" Text="Cashier"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#283645"/>
                            <TextBlock Text="Point of sale"
                                       FontSize="9"
                                       Foreground="#87929D"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Column="1" Margin="16,0,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TOP BAR -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="☰"
                               FontSize="15"
                               Foreground="#697785"
                               VerticalAlignment="Center"
                               Margin="0,0,24,0"/>

                    <TextBlock Text="New Sale"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="#253342"
                               VerticalAlignment="Center"/>

                    <Border Background="#EAF6FC"
                            CornerRadius="12"
                            Padding="9,4"
                            Margin="12,0,0,0">
                        <TextBlock x:Name="ReceiptNumberText"
                                   Text="Receipt #2026-0001"
                                   FontSize="9"
                                   Foreground="#078BC5"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="↶  Returns"
                            Style="{StaticResource SmallActionButton}"/>
                    <Button Content="◷  History"
                            Style="{StaticResource SmallActionButton}"/>
                    <Button Content="▦  Shortcuts"
                            Style="{StaticResource SmallActionButton}"
                            Margin="0"/>
                </StackPanel>
            </Grid>

            <!-- CATALOG AND OVERLAY CART -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="245"/>
                </Grid.ColumnDefinitions>

                <!-- PRODUCT CATALOG -->
                <Grid Grid.Column="0" Margin="0,0,13,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="43"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Search -->
                    <Border Grid.Row="0"
                            Background="White"
                            BorderBrush="#E5EAF0"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,0">
                        <DockPanel VerticalAlignment="Center">
                            <TextBlock Text="⌕"
                                       FontSize="19"
                                       Foreground="#83909C"
                                       Margin="0,0,8,0"/>

                            <TextBox x:Name="SearchBox"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     FontSize="11"
                                     VerticalContentAlignment="Center"
                                     ToolTip="Search products by name, SKU or barcode"
                                     TextChanged="SearchBox_TextChanged"/>

                            <TextBlock Text="▥"
                                       FontSize="14"
                                       Foreground="#82909C"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <!-- Categories -->
                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled"
                                  Margin="0,9,0,4">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="All Products"
                                    Style="{StaticResource CategoryButton}"
                                    Background="#078BC5"
                                    Foreground="White"
                                    BorderBrush="#078BC5"
                                    Tag="All"
                                    Click="Category_Click"/>

                            <Button Content="Electronics"
                                    Style="{StaticResource CategoryButton}"
                                    Tag="Electronics"
                                    Click="Category_Click"/>

                            <Button Content="Clothing"
                                    Style="{StaticResource CategoryButton}"
                                    Tag="Clothing"
                                    Click="Category_Click"/>

                            <Button Content="Home &amp; Kitchen"
                                    Style="{StaticResource CategoryButton}"
                                    Tag="Home"
                                    Click="Category_Click"/>

                            <Button Content="Beauty"
                                    Style="{StaticResource CategoryButton}"
                                    Tag="Beauty"
                                    Click="Category_Click"/>

                            <Button Content="Food &amp; Beverages"
                                    Style="{StaticResource CategoryButton}"
                                    Tag="Food"
                                    Click="Category_Click"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Product cards -->
                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">

                        <ItemsControl x:Name="ProductsItems">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ProductCard}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="100"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="24"/>
                                            </Grid.RowDefinitions>

                                            <Border Grid.Row="0"
                                                    Background="#F7F8FA"
                                                    CornerRadius="4"
                                                    Margin="0,0,0,8">
                                                <Grid>
                                                    <Image Source="{Binding ImagePath}"
                                                           Stretch="Uniform"
                                                           Margin="6"/>

                                                    <TextBlock Text="▧"
                                                               FontSize="27"
                                                               Foreground="#D4DCE4"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               IsHitTestVisible="False"/>
                                                </Grid>
                                            </Border>

                                            <Grid Grid.Row="1">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="#253342"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center"
                                                           Margin="0,0,5,0"/>

                                                <TextBlock Text="{Binding Price, StringFormat={}{0:N2}}"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Foreground="#078BC5"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"/>
                                            </Grid>

                                            <TextBlock Grid.Row="2"
                                                       Text="{Binding Barcode, StringFormat=SKU: {0}}"
                                                       FontSize="9"
                                                       Foreground="#778592"
                                                       Margin="0,4,0,0"
                                                       TextTrimming="CharacterEllipsis"/>

                                            <TextBlock Grid.Row="3"
                                                       Text="●  In Stock"
                                                       FontSize="9"
                                                       Foreground="#15945B"
                                                       Margin="0,7,0,4"/>

                                            <Button Grid.Row="4"
                                                    Content="+"
                                                    Width="24"
                                                    Height="24"
                                                    HorizontalAlignment="Right"
                                                    Background="#EAF7FC"
                                                    Foreground="#078BC5"
                                                    BorderThickness="0"
                                                    FontSize="17"
                                                    Tag="{Binding}"
                                                    Click="AddProduct_Click"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- RIGHT SIDE: CUSTOMER + CART -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="96"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Customer -->
                    <StackPanel Grid.Row="0">
                        <Grid Margin="0,7,0,9">
                            <TextBlock Text="Customer"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#344251"
                                       VerticalAlignment="Center"/>

                            <Button Content="+ Add New"
                                    Background="Transparent"
                                    Foreground="#078BC5"
                                    BorderThickness="0"
                                    FontSize="10"
                                    HorizontalAlignment="Right"
                                    Padding="0"
                                    Click="SelectCustomer_Click"/>
                        </Grid>

                        <Border Background="White"
                                BorderBrush="#E6EBF0"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="9">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="31"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="27"
                                        Height="27"
                                        CornerRadius="15"
                                        Background="#EDF1F5">
                                    <TextBlock Text="♙"
                                               FontSize="15"
                                               Foreground="#657587"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Margin="5,0,0,0">
                                    <TextBlock Text="Walk-in Customer"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Foreground="#344251"/>
                                    <TextBlock Text="No loyalty points"
                                               FontSize="9"
                                               Foreground="#83909C"
                                               Margin="0,3,0,0"/>
                                </StackPanel>

                                <TextBlock Grid.Column="2"
                                           Text="⌄"
                                           FontSize="14"
                                           Foreground="#87929D"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Floating-style invoice card -->
                    <Border Grid.Row="1"
                            Background="White"
                            BorderBrush="#E6EBF0"
                            BorderThickness="1"
                            CornerRadius="7"
                            Padding="10"
                            Margin="0,8,0,0">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="29"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="Cart Items"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#263543"
                                       VerticalAlignment="Top"/>

                            <!-- Cart list -->
                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="CartItems">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#E9EDF1"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="0,8">

                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="35"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Width="31"
                                                            Height="37"
                                                            CornerRadius="3"
                                                            Background="#F1F4F7">
                                                        <Image Source="{Binding ImagePath}"
                                                               Stretch="Uniform"
                                                               Margin="3"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1"
                                                                Margin="6,0,3,0">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#344251"
                                                                   TextWrapping="Wrap"
                                                                   MaxHeight="28"/>

                                                        <TextBlock Text="{Binding UnitPrice, StringFormat={}{0:N2}}"
                                                                   FontSize="9"
                                                                   Foreground="#078BC5"
                                                                   Margin="0,3,0,4"/>

                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Content="−"
                                                                    Width="19"
                                                                    Height="19"
                                                                    Padding="0"
                                                                    FontSize="10"
                                                                    Tag="{Binding}"
                                                                    Background="#F4F6F8"
                                                                    BorderBrush="#E6EBF0"
                                                                    Click="DecreaseQuantity_Click"/>

                                                            <TextBlock Text="{Binding Quantity}"
                                                                       Width="23"
                                                                       FontSize="9"
                                                                       TextAlignment="Center"
                                                                       VerticalAlignment="Center"/>

                                                            <Button Content="+"
                                                                    Width="19"
                                                                    Height="19"
                                                                    Padding="0"
                                                                    FontSize="10"
                                                                    Tag="{Binding}"
                                                                    Background="#F4F6F8"
                                                                    BorderBrush="#E6EBF0"
                                                                    Click="IncreaseQuantity_Click"/>
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2"
                                                                HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding Total, StringFormat={}{0:N2}}"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#078BC5"/>

                                                        <Button Content="▤"
                                                                Width="19"
                                                                Height="19"
                                                                Margin="0,9,0,0"
                                                                Padding="0"
                                                                Foreground="#EF4444"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Tag="{Binding}"
                                                                Click="RemoveCartItem_Click"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <!-- Totals and payment methods remain inside the cart -->
                            <StackPanel Grid.Row="2" Margin="0,8,0,0">

                                <Grid Margin="0,0,0,7">
                                    <TextBlock Text="Subtotal"
                                               FontSize="10"
                                               Foreground="#687785"/>
                                    <TextBlock x:Name="SubtotalText"
                                               Text="0.00 EGP"
                                               FontSize="10"
                                               Foreground="#344251"
                                               HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,0,0,7">
                                    <TextBlock Text="VAT (14%)"
                                               FontSize="10"
                                               Foreground="#687785"/>
                                    <TextBlock x:Name="VatText"
                                               Text="0.00 EGP"
                                               FontSize="10"
                                               Foreground="#344251"
                                               HorizontalAlignment="Right"/>
                                </Grid>

                                <Grid Margin="0,0,0,7">
                                    <TextBlock Text="Discount"
                                               FontSize="10"
                                               Foreground="#687785"/>
                                    <TextBlock x:Name="DiscountText"
                                               Text="0.00 EGP"
                                               FontSize="10"
                                               Foreground="#344251"
                                               HorizontalAlignment="Right"/>
                                </Grid>

                                <Border Height="1"
                                        Background="#E9EDF1"
                                        Margin="0,2,0,8"/>

                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="Total"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#263543"
                                               VerticalAlignment="Center"/>

                                    <TextBlock x:Name="TotalText"
                                               Text="0.00 EGP"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="#078BC5"
                                               HorizontalAlignment="Right"/>
                                </Grid>

                                <Button Content="◆  Apply Discount / Coupon"
                                        Height="30"
                                        Margin="0,0,0,8"
                                        Background="#F0F8FC"
                                        Foreground="#078BC5"
                                        BorderBrush="#D9EFF9"
                                        BorderThickness="1"
                                        FontSize="10"/>

                                <!-- Payment options directly under invoice totals -->
                                <UniformGrid Columns="2" Rows="3">

                                    <Button x:Name="CardButton"
                                            Tag="Card"
                                            Style="{StaticResource PaymentButton}"
                                            Background="#078BC5"
                                            Foreground="White"
                                            Content="▣  Card"
                                            Click="PaymentMethod_Click"/>

                                    <Button x:Name="CashButton"
                                            Tag="Cash"
                                            Style="{StaticResource PaymentButton}"
                                            Background="#159B55"
                                            Foreground="White"
                                            Content="▤  Cash"
                                            Click="PaymentMethod_Click"/>

                                    <Button x:Name="InstaPayButton"
                                            Tag="InstaPay"
                                            Style="{StaticResource PaymentButton}"
                                            Content="↗  InstaPay"
                                            Click="PaymentMethod_Click"/>

                                    <Button x:Name="EWalletButton"
                                            Tag="EWallet"
                                            Style="{StaticResource PaymentButton}"
                                            Content="▣  E-Wallet"
                                            Click="PaymentMethod_Click"/>

                                    <Button x:Name="SplitButton"
                                            Grid.ColumnSpan="2"
                                            Style="{StaticResource PaymentButton}"
                                            Content="⇄  Split Payment"
                                            Click="SplitPayment_Click"/>

                                </UniformGrid>

                                <TextBlock Text="Amount received"
                                           FontSize="10"
                                           Foreground="#687785"
                                           Margin="0,6,0,4"/>

                                <TextBox x:Name="AmountReceivedBox"
                                         Height="31"
                                         Padding="8,0"
                                         FontSize="11"
                                         VerticalContentAlignment="Center"
                                         Text="0.00"/>

                                <Button Content="Complete Sale  →"
                                        Height="35"
                                        Margin="0,7,0,0"
                                        Background="#078BC5"
                                        Foreground="White"
                                        BorderThickness="0"
                                        FontWeight="SemiBold"
                                        FontSize="11"
                                        Click="CompletePayment_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
