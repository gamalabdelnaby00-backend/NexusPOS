<Window x:Class="NexusPOS.PurchaseEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="فاتورة مشتريات جديدة"
        Height="760"
        Width="1180"
        MinHeight="650"
        MinWidth="950"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="#F3F6FC"
        FontFamily="Segoe UI">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#1768E8"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#DCE5F2"/>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="Background" Value="White"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- عنوان الشاشة -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="20"
                Margin="0,0,0,16">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="فاتورة مشتريات جديدة"
                               FontSize="25"
                               FontWeight="Bold"
                               Foreground="#17345A"/>

                    <TextBlock Text="إضافة أصناف المورد ومراجعة الفاتورة قبل الحفظ"
                               Margin="0,7,0,0"
                               Foreground="#71829A"
                               FontSize="13"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="✕ إغلاق"
                        Width="100"
                        Background="#FFF0F0"
                        Foreground="#B42332"
                        BorderBrush="#FFD5D5"
                        Click="CloseButton_Click"/>
            </Grid>
        </Border>

        <!-- بيانات الفاتورة -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="20"
                Margin="0,0,0,16">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="بيانات الفاتورة"
                           FontSize="17"
                           FontWeight="Bold"
                           Foreground="#17345A"
                           Margin="0,0,0,16"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="5">
                        <TextBlock Text="المورد"
                                   Margin="0,0,0,8"
                                   FontWeight="SemiBold"/>

                        <ComboBox x:Name="SupplierComboBox"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"
                                  SelectionChanged="SupplierComboBox_SelectionChanged"
                                  IsEditable="False"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="5">
                        <TextBlock Text="رقم فاتورة المورد"
                                   Margin="0,0,0,8"
                                   FontWeight="SemiBold"/>

                        <TextBox x:Name="SupplierInvoiceNumberTextBox"
                                 MaxLength="100"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="5">
                        <TextBlock Text="تاريخ الفاتورة"
                                   Margin="0,0,0,8"
                                   FontWeight="SemiBold"/>

                        <DatePicker x:Name="InvoiceDatePicker"
                                    SelectedDate="{x:Static sys:DateTime.Today}"
                                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                                    Height="40"
                                    FontSize="14"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- الأصناف -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="20"
                Margin="0,0,0,16">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="إضافة أصناف الفاتورة"
                           FontSize="17"
                           FontWeight="Bold"
                           Foreground="#17345A"
                           Margin="0,0,0,16"/>

                <Grid Grid.Row="1" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.3*"/>
                        <ColumnDefinition Width="0.8*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="4">
                        <TextBlock Text="المنتج"
                                   Margin="0,0,0,8"
                                   FontWeight="SemiBold"/>

                        <ComboBox x:Name="ProductComboBox"
                                  DisplayMemberPath="Name"
                                  SelectedValuePath="Id"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="4">
                        <TextBlock Text="الكمية"
                                   Margin="0,0,0,8"
                                   FontWeight="SemiBold"/>

                        <TextBox x:Name="QuantityTextBox"
                                 Text="1"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="4">
                        <TextBlock Text="سعر الوحدة"
                                   Margin="0,0,0,8"
                                   FontWeight="SemiBold"/>

                        <TextBox x:Name="UnitCostTextBox"
                                 Text="0.00"/>
                    </StackPanel>

                    <Button Grid.Column="3"
                            Content="＋ إضافة الصنف"
                            VerticalAlignment="Bottom"
                            Background="#1768E8"
                            Foreground="White"
                            BorderThickness="0"
                            Click="AddItemButton_Click"/>
                </Grid>

                <DataGrid Grid.Row="2"
                          x:Name="PurchaseItemsDataGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          Background="White"
                          BorderBrush="{StaticResource BorderBrush}"
                          RowHeight="42"
                          ColumnHeaderHeight="42"
                          FontSize="13">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="كود المنتج"
                                            Binding="{Binding ProductId}"
                                            Width="1*"/>

                        <DataGridTextColumn Header="اسم المنتج"
                                            Binding="{Binding ProductName}"
                                            Width="2.5*"/>

                        <DataGridTextColumn Header="الكمية"
                                            Binding="{Binding Quantity}"
                                            Width="1*"/>

                        <DataGridTextColumn Header="سعر الوحدة"
                                            Binding="{Binding UnitCost, StringFormat=N2}"
                                            Width="1.2*"/>

                        <DataGridTextColumn Header="الإجمالي"
                                            Binding="{Binding LineTotal, StringFormat=N2}"
                                            Width="1.2*"/>

                        <DataGridTemplateColumn Header="حذف"
                                                Width="Auto">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="حذف"
                                            Height="30"
                                            Padding="8,2"
                                            Margin="2"
                                            Background="#FFF0F0"
                                            Foreground="#B42332"
                                            BorderBrush="#FFD5D5"
                                            Click="RemoveItemButton_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="3"
                        Background="#F4F7FC"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0,16,0,0">

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="إجمالي الفاتورة"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>

                        <TextBlock x:Name="TotalTextBlock"
                                   Grid.Column="1"
                                   Text="0.00 ج.م"
                                   FontSize="23"
                                   FontWeight="Bold"
                                   Foreground="#1768E8"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- أزرار التعامل مع الفاتورة -->
        <Border Grid.Row="3"
                Background="White"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="12">

            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal"
                            DockPanel.Dock="Right">

                    <Button Content="حفظ الفاتورة"
                            Width="145"
                            Background="#1768E8"
                            Foreground="White"
                            BorderThickness="0"
                            Click="SaveButton_Click"/>

                    <Button Content="حفظ واستلام"
                            Width="145"
                            Background="#159B59"
                            Foreground="White"
                            BorderThickness="0"
                            Click="ReceiveButton_Click"/>
                </StackPanel>

                <Button DockPanel.Dock="Left"
                        Content="إلغاء"
                        Width="100"
                        Background="#E8EEF7"
                        Foreground="#29415F"
                        BorderThickness="0"
                        Click="CancelButton_Click"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
