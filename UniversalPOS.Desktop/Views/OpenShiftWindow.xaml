<Window x:Class="UniversalPOS.Desktop.Views.OpenShiftWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Open Cash Shift"
        Width="440"
        Height="380"
        MinWidth="360"
        MinHeight="340"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#F3F5F9">

    <Grid Margin="20">
        <Border Background="White"
                Padding="24"
                CornerRadius="12">

            <StackPanel>
                <TextBlock Text="Open Cash Shift"
                           FontSize="25"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8"/>

                <TextBlock Text="Enter the opening cash amount"
                           Foreground="Gray"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,24"/>

                <TextBlock Text="Opening cash amount"/>
                <TextBox x:Name="OpeningFloatTextBox"
                         Height="40"
                         Padding="8"
                         FontSize="16"
                         Margin="0,8,0,16"
                         Text="0"/>

                <TextBlock x:Name="ErrorText"
                           Foreground="Red"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12"/>

                <Button x:Name="OpenShiftButton"
                        Content="Open Shift"
                        Height="44"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Background="#2457C5"
                        Foreground="White"
                        BorderThickness="0"
                        Click="OpenShiftButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
