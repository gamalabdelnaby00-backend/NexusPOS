<Window x:Class="UniversalPOS.Desktop.Views.SupplierEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إضافة مورد جديد"
        Width="650"
        Height="570"
        MinWidth="550"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#F4F7FC"
        FlowDirection="RightToLeft"
        FontFamily="Segoe UI"
        UseLayoutRounding="True">

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#1768E8"/>
        <SolidColorBrush x:Key="TextBrush" Color="#172B4D"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#71829B"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#DCE5F1"/>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#172B4D"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#DCE5F1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="InputBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="InputBorder"
                                        Property="BorderBrush"
                                        Value="#1768E8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Background" Value="#1768E8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#E8EEF7"/>
            <Setter Property="Foreground" Value="#29415F"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="#FFFFFF"
                BorderBrush="#E2EAF5"
                BorderThickness="1"
                CornerRadius="14"
                Padding="20"
                Margin="0,0,0,18">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Width="52"
                        Height="52"
                        CornerRadius="12"
                        Background="#EAF1FF"
                        VerticalAlignment="Center">
                    <TextBlock Text="♙"
                               FontSize="27"
                               Foreground="#1768E8"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1"
                            Margin="14,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock Text="إضافة مورد جديد"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextBrush}"/>

                    <TextBlock Text="أدخل بيانات المورد الأساسية لحفظها في النظام"
                               Margin="0,6,0,0"
                               FontSize="13"
                               Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Form -->
        <Border Grid.Row="1"
                Background="#FFFFFF"
                BorderBrush="#E2EAF5"
                BorderThickness="1"
                CornerRadius="14"
                Padding="24">

            <StackPanel>
                <TextBlock Text="بيانات المورد"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"
                           Margin="0,0,0,22"/>

                <TextBlock Text="اسم المورد *"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Foreground="#314663"
                           Margin="0,0,0,8"/>

                <TextBox x:Name="NameTextBox"
                         Style="{StaticResource InputStyle}"
                         ToolTip="اكتب اسم المورد"/>

                <TextBlock Text="رقم الهاتف"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Foreground="#314663"
                           Margin="0,20,0,8"/>

                <TextBox x:Name="PhoneTextBox"
                         Style="{StaticResource InputStyle}"
                         ToolTip="اكتب رقم هاتف المورد"
                         FlowDirection="LeftToRight"
                         HorizontalContentAlignment="Right"/>

                <TextBlock Text="الرقم الضريبي"
                           FontWeight="SemiBold"
                           FontSize="13"
                           Foreground="#314663"
                           Margin="0,20,0,8"/>

                <TextBox x:Name="TaxNumberTextBox"
                         Style="{StaticResource InputStyle}"
                         ToolTip="اكتب الرقم الضريبي إن وجد"
                         FlowDirection="LeftToRight"
                         HorizontalContentAlignment="Right"/>

                <TextBlock Text="* الحقول الإلزامية موضحة بعلامة النجمة"
                           FontSize="12"
                           Foreground="{StaticResource MutedBrush}"
                           Margin="0,18,0,0"/>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="2"
                Background="#FFFFFF"
                BorderBrush="#E2EAF5"
                BorderThickness="1"
                CornerRadius="14"
                Padding="16"
                Margin="0,18,0,0">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Left">

                <Button x:Name="SaveButton"
                        Content="حفظ المورد"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="0,0,10,0"
                        IsDefault="True"/>

                <Button x:Name="CancelButton"
                        Content="إلغاء"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsCancel="True"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
