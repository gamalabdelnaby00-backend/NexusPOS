<Window x:Class="UniversalPOS.Desktop.Views.RolePermissionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إدارة الأدوار والصلاحيات"
        Height="780"
        Width="1180"
        MinHeight="650"
        MinWidth="950"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="#F3F6FC"
        FontFamily="Segoe UI"
        FontSize="14">

    <Window.Resources>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1768E8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="18,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#E8F0FF"/>
            <Setter Property="Foreground" Value="#174A91"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="4"/>
        </Style>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="BorderBrush" Value="#E1E9F5"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#172D4D"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="الأدوار والصلاحيات"
                           FontSize="27"
                           FontWeight="Bold"
                           Foreground="#14243D"/>

                <TextBlock Text="إدارة صلاحيات المستخدمين والتحكم في الوصول إلى وظائف النظام"
                           Foreground="#71829A"
                           Margin="0,7,0,0"/>
            </StackPanel>

            <Border Grid.Column="1"
                    Background="#E5F7ED"
                    CornerRadius="8"
                    Padding="12,8"
                    VerticalAlignment="Center">
                <TextBlock Text="● إدارة الصلاحيات"
                           Foreground="#16814A"
                           FontWeight="SemiBold"/>
            </Border>
        </Grid>

        <!-- Role selection -->
        <Border Grid.Row="1"
                Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="الدور الوظيفي"
                               FontWeight="SemiBold"
                               Foreground="#314663"
                               Margin="0,0,0,8"/>

                    <ComboBox x:Name="RoleComboBox"
                              Height="42"
                              Padding="10,7"
                              VerticalContentAlignment="Center"
                              IsEditable="False"
                              ToolTip="اختر الدور المراد تعديل صلاحياته"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="بحث عن صلاحية"
                               FontWeight="SemiBold"
                               Foreground="#314663"
                               Margin="0,0,0,8"/>

                    <TextBox x:Name="SearchTextBox"
                             Height="42"
                             Padding="12,9"
                             VerticalContentAlignment="Center"
                             BorderBrush="#DCE5F1"
                             BorderThickness="1"
                             Background="#FBFCFF"
                             ToolTip="اكتب اسم الصلاحية للبحث"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Permissions -->
        <Border Grid.Row="2"
                Style="{StaticResource CardStyle}"
                Padding="18">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,14">
                    <TextBlock Text="الصلاحيات المتاحة"
                               Style="{StaticResource SectionTitle}"
                               Margin="0"
                               VerticalAlignment="Center"/>

                    <StackPanel DockPanel.Dock="Left"
                                Orientation="Horizontal">

                        <Button x:Name="SelectAllButton"
                                Content="تحديد الكل"
                                Style="{StaticResource SecondaryButton}"/>

                        <Button x:Name="ClearAllButton"
                                Content="إلغاء التحديد"
                                Style="{StaticResource SecondaryButton}"/>
                    </StackPanel>
                </DockPanel>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <!--
                    سيقوم الكود الخلفي بإنشاء مجموعات الصلاحيات
                    داخل هذا العنصر باستخدام البيانات الفعلية.
                    -->

                    <StackPanel x:Name="PermissionGroupsPanel"
                                Margin="0,4,4,0"/>

                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Footer -->
        <Border Grid.Row="3"
                Background="White"
                BorderBrush="#E1E9F5"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14"
                Margin="0,14,0,0">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="مراجعة الصلاحيات"
                               FontWeight="Bold"
                               Foreground="#172D4D"/>

                    <TextBlock x:Name="SelectedPermissionsText"
                               Text="عدد الصلاحيات المحددة: 0"
                               Foreground="#71829A"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <Button x:Name="CancelButton"
                            Content="إغلاق"
                            MinWidth="100"
                            Style="{StaticResource SecondaryButton}"/>

                    <Button x:Name="SaveButton"
                            Content="حفظ الصلاحيات"
                            MinWidth="150"
                            Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </Grid>
        </Border>

    </Grid>
</Window>
