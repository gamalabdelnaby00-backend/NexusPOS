<Window x:Class="UniversalPOS.Desktop.Views.ReturnsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="المرتجعات | Returns" Height="760" Width="1180" MinHeight="650" MinWidth="950"
        WindowStartupLocation="CenterOwner" Background="#F3F5F9" FlowDirection="RightToLeft" FontFamily="Segoe UI">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="#263B55" CornerRadius="12" Padding="20" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="إدارة مرتجعات المبيعات" Foreground="White" FontSize="25" FontWeight="Bold"/>
                <TextBlock Text="ابحث عن فاتورة مكتملة، وحدد الأصناف والكميات المراد إرجاعها." Foreground="#D9E4F2" FontSize="13" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="1" Background="White" BorderBrush="#E0E6EF" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="180"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Text="رقم الفاتورة" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,12,0"/>
                <TextBox x:Name="SaleIdBox" Grid.Column="1" Height="36" Padding="8,5" VerticalContentAlignment="Center"/>
                <Button Grid.Column="2" Content="بحث عن الفاتورة" Click="SearchSale_Click" Background="#2457C5" Foreground="White" BorderThickness="0" Padding="18,7" Margin="10,0" FontWeight="SemiBold"/>
                <TextBlock x:Name="SaleSummaryText" Grid.Column="3" Text="أدخل رقم الفاتورة للبدء" VerticalAlignment="Center" Foreground="#52647A" Margin="12,0,0,0"/>
            </Grid>
        </Border>
        <Border Grid.Row="2" Background="White" BorderBrush="#E0E6EF" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,14">
            <DataGrid x:Name="ItemsGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" RowHeight="42" ColumnHeaderHeight="40" SelectionUnit="CellOrRowHeader">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الصنف" Binding="{Binding ProductName}" IsReadOnly="True" Width="2*"/>
                    <DataGridTextColumn Header="سعر الوحدة" Binding="{Binding UnitPrice, StringFormat=N2}" IsReadOnly="True" Width="*"/>
                    <DataGridTextColumn Header="الكمية المباعة" Binding="{Binding SoldQuantity, StringFormat=N3}" IsReadOnly="True" Width="*"/>
                    <DataGridTextColumn Header="مرتجع سابقًا" Binding="{Binding PreviouslyReturned, StringFormat=N3}" IsReadOnly="True" Width="*"/>
                    <DataGridTextColumn Header="المتاح للإرجاع" Binding="{Binding RemainingQuantity, StringFormat=N3}" IsReadOnly="True" Width="*"/>
                    <DataGridTextColumn Header="كمية الإرجاع" Binding="{Binding ReturnQuantity, UpdateSourceTrigger=PropertyChanged, StringFormat=N3}" Width="*"/>
                    <DataGridCheckBoxColumn Header="إعادة للمخزون" Binding="{Binding IsRestockable, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                    <DataGridTextColumn Header="قيمة المرتجع" Binding="{Binding RefundAmount, StringFormat=N2}" IsReadOnly="True" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <Border Grid.Row="3" Background="White" BorderBrush="#E0E6EF" BorderThickness="1" CornerRadius="10" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0"><TextBlock Text="سبب الإرجاع *" FontWeight="SemiBold" Margin="0,0,0,5"/><TextBox x:Name="ReasonBox" Height="36" Padding="8,5" VerticalContentAlignment="Center"/></StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="طريقة رد المبلغ" FontWeight="SemiBold" Margin="0,0,0,5"/><ComboBox x:Name="RefundMethodBox" Height="36" Padding="6"/></StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,12,0"><TextBlock Text="مرجع العملية (اختياري)" FontWeight="SemiBold" Margin="0,0,0,5"/><TextBox x:Name="ReferenceBox" Height="36" Padding="8,5" VerticalContentAlignment="Center"/><TextBlock x:Name="TotalText" Text="إجمالي المرتجع: 0.00" FontSize="16" FontWeight="Bold" Foreground="#2457C5" Margin="0,7,0,0"/></StackPanel>
                <Button Grid.Column="3" Content="تأكيد المرتجع" Click="ProcessReturn_Click" Background="#16845B" Foreground="White" BorderThickness="0" Padding="22,12" FontWeight="Bold" VerticalAlignment="Center" MinWidth="135"/>
            </Grid>
        </Border>
    </Grid>
</Window>
