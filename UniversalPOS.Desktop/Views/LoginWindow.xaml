<Window x:Class="UniversalPOS.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:localization="clr-namespace:UniversalPOS.Desktop"
        Title="{Binding [LoginTitle], Source={x:Static localization:LocalizationManager.Current}}"
        FlowDirection="{Binding FlowDirection, Source={x:Static localization:LocalizationManager.Current}}"
        Width="460"
        Height="560"
        MinWidth="360"
        MinHeight="350"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#F3F5F9">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="12">

            <Border Padding="24"
                    Background="White"
                    CornerRadius="12"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top">

                <StackPanel>
                    <ComboBox x:Name="LanguageSelector" Width="130" HorizontalAlignment="Right" Margin="0,0,0,12" SelectionChanged="LanguageSelector_SelectionChanged">
                        <ComboBoxItem Content="English" Tag="en-US"/>
                        <ComboBoxItem Content="العربية" Tag="ar-EG"/>
                    </ComboBox>

                    <TextBlock Text="UniversalPOS"
                               FontSize="28"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,6"/>

                    <TextBlock Text="{Binding [SignInSubtitle], Source={x:Static localization:LocalizationManager.Current}}"
                               FontSize="14"
                               Foreground="Gray"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,28"/>

                    <TextBlock Text="{Binding [Username], Source={x:Static localization:LocalizationManager.Current}}"
                               Margin="0,0,0,6"/>

                    <TextBox x:Name="UserNameTextBox"
                             Height="40"
                             Padding="8"
                             FontSize="15"
                             Margin="0,0,0,16"/>

                    <TextBlock Text="{Binding [Password], Source={x:Static localization:LocalizationManager.Current}}"
                               Margin="0,0,0,6"/>

                    <PasswordBox x:Name="PasswordInput"
                                 Height="40"
                                 Padding="8"
                                 FontSize="15"
                                 Margin="0,0,0,20"/>

                    <TextBlock x:Name="ErrorText"
                               Foreground="Red"
                               TextWrapping="Wrap"
                               Margin="0,0,0,12"/>

                    <Button x:Name="LoginButton"
                            Content="{Binding [Login], Source={x:Static localization:LocalizationManager.Current}}"
                            Height="44"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Background="#2457C5"
                            Foreground="White"
                            BorderThickness="0"
                            Click="LoginButton_Click"/>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>
