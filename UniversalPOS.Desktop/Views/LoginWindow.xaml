<Window x:Class="UniversalPOS.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:UniversalPOS.Desktop"
        Title="NexusPOS - تسجيل الدخول"
        Width="1440" Height="850" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
        UseLayoutRounding="True" SnapsToDevicePixels="True" FontFamily="Segoe UI">

    <!-- Same palette as the main application: blue #0A74F0, deep blue #0B4FB3, navy #0B2A4F, page #EAF1FA. -->
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F7FAFF" Offset="0"/>
            <GradientStop Color="#E3EEFB" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Window.Resources>
        <Geometry x:Key="LIcon.User">M12 6c1.1 0 2 .9 2 2s-.9 2-2 2-2-.9-2-2 .9-2 2-2m0 9c2.7 0 5.8 1.29 6 2v1H6v-1c.2-.71 3.3-2 6-2M12 4C9.79 4 8 5.79 8 8s1.79 4 4 4 4-1.79 4-4-1.79-4-4-4zm0 9c-2.67 0-8 1.34-8 4v3h16v-3c0-2.66-5.33-4-8-4z</Geometry>
        <Geometry x:Key="LIcon.Lock">M12 17c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm6-9h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zM8.9 6c0-1.71 1.39-3.1 3.1-3.1s3.1 1.39 3.1 3.1v2H8.9V6zM18 20H6V10h12v10z</Geometry>
        <Geometry x:Key="LIcon.Eye">M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z</Geometry>
        <Geometry x:Key="LIcon.EyeOff">M12 7c2.76 0 5 2.24 5 5 0 .65-.13 1.26-.36 1.83l2.92 2.92c1.51-1.26 2.7-2.89 3.43-4.75-1.73-4.39-6-7.5-11-7.5-1.4 0-2.74.25-3.98.7l2.16 2.16C10.74 7.13 11.35 7 12 7zM2 4.27l2.28 2.28.46.46C3.08 8.3 1.78 10.02 1 12c1.73 4.39 6 7.5 11 7.5 1.55 0 3.03-.3 4.38-.84l.42.42L19.73 22 21 20.73 3.27 3 2 4.27zM7.53 9.8l1.55 1.55c-.05.21-.08.43-.08.65 0 1.66 1.34 3 3 3 .22 0 .44-.03.65-.08l1.55 1.55c-.67.33-1.41.53-2.2.53-2.76 0-5-2.24-5-5 0-.79.2-1.53.53-2.2zm4.31-.78l3.15 3.15.02-.16c0-1.66-1.34-3-3-3l-.17.01z</Geometry>

        <Geometry x:Key="LIcon.Globe">M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zm6.93 6h-2.95c-.32-1.25-.78-2.45-1.38-3.56 1.84.63 3.37 1.91 4.33 3.56zM12 4.04c.83 1.2 1.48 2.53 1.91 3.96h-3.82c.43-1.43 1.08-2.76 1.91-3.96zM4.26 14C4.1 13.36 4 12.69 4 12s.1-1.36.26-2h3.38c-.08.66-.14 1.32-.14 2 0 .68.06 1.34.14 2H4.26zm.82 2h2.95c.32 1.25.78 2.45 1.38 3.56-1.84-.63-3.37-1.9-4.33-3.56zm2.95-8H5.08c.96-1.66 2.49-2.93 4.33-3.56C8.81 5.55 8.35 6.75 8.03 8zM12 19.96c-.83-1.2-1.48-2.53-1.91-3.96h3.82c-.43 1.43-1.08 2.76-1.91 3.96zM14.34 14H9.66c-.09-.66-.16-1.32-.16-2 0-.68.07-1.35.16-2h4.68c.09.65.16 1.32.16 2 0 .68-.07 1.34-.16 2zm.25 5.56c.6-1.11 1.06-2.31 1.38-3.56h2.95c-.96 1.65-2.49 2.93-4.33 3.56zM16.36 14c.08-.66.14-1.32.14-2 0-.68-.06-1.34-.14-2h3.38c.16.64.26 1.31.26 2s-.1 1.36-.26 2h-3.38z</Geometry>
        <Geometry x:Key="LIcon.ChevronDown">M16.59 8.59L12 13.17 7.41 8.59 6 10l6 6 6-6z</Geometry>
        <Geometry x:Key="LIcon.Check">M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z</Geometry>

        <SolidColorBrush x:Key="Navy" Color="#0B2A4F"/>
        <SolidColorBrush x:Key="Ink" Color="#12294A"/>
        <SolidColorBrush x:Key="Muted" Color="#5F7390"/>
        <SolidColorBrush x:Key="Blue" Color="#0A74F0"/>

        <!-- Rounded field container; the border turns blue while any child has keyboard focus. -->
        <Style x:Key="FieldBorder" TargetType="Border">
            <Setter Property="Height" Value="54"/>
            <Setter Property="Background" Value="#F3F6FA"/>
            <Setter Property="BorderBrush" Value="#D3DDEA"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CornerRadius" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="#0A74F0"/>
                    <Setter Property="Background" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FieldTextBox" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#12294A"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>

        <Style x:Key="FieldPasswordBox" TargetType="PasswordBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="#12294A"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>

        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7C8DA6"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0"/>
        </Style>

        <Style x:Key="LoginButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="54"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="11">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#0A74F0" Offset="0"/>
                                    <GradientStop Color="#0B5FCC" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.9"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.8"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.55"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LanguagePillStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="White" BorderBrush="#D3E2F5" BorderThickness="1.5" CornerRadius="13" Padding="6,5,12,5">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.08" Color="#0B2A4F"/>
                            </Border.Effect>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#0A74F0"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LanguageOptionStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="12,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#EAF3FF"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="EyeButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#E6EEF8"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Fixed left-to-right frame: branding on the left and the card on the right in both languages (as in the mockup).
         Only the card and the language menu follow the selected reading direction. -->
    <Grid FlowDirection="LeftToRight">
        <!-- Soft orbit rings echoing the logo; purely decorative. -->
        <Grid IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Width="1100" Height="420" Stroke="#0A74F0" StrokeThickness="2" Opacity="0.10"
                     HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-380,-120" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform><RotateTransform Angle="-18"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Width="800" Height="300" Stroke="#0B4FB3" StrokeThickness="1.5" Opacity="0.08"
                     HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-260,-40" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform><RotateTransform Angle="-18"/></Ellipse.RenderTransform>
            </Ellipse>
            <Ellipse Width="720" Height="720" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,40,0">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#B9D9FF" Offset="0"/>
                        <GradientStop Color="#00B9D9FF" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
        </Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid MinHeight="620">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*"/>
                    <ColumnDefinition Width="*" MinWidth="430"/>
                </Grid.ColumnDefinitions>

                <!-- Login card (right) -->
                <Border x:Name="LoginCard" Grid.Column="1" Background="White" BorderBrush="#DCE8F7" BorderThickness="1" CornerRadius="16"
                        Padding="36,34" Margin="24,40,70,40" MaxWidth="480" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="40" ShadowDepth="8" Direction="270" Opacity="0.12" Color="#0B2A4F"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock x:Name="WelcomeText" Text="مرحبًا بك مجددًا في NexusPOS!" FontSize="23" FontWeight="Bold"
                                   Foreground="{StaticResource Navy}" TextWrapping="Wrap" Margin="0,0,0,26"/>

                        <!-- Username or e-mail -->
                        <Border Style="{StaticResource FieldBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Path Data="{StaticResource LIcon.User}" Fill="#6B7F99" Width="22" Height="22" Stretch="Uniform" Margin="14,0,6,0"/>
                                <Grid Grid.Column="1">
                                    <TextBox x:Name="UserNameTextBox" Style="{StaticResource FieldTextBox}" MaxLength="100"
                                             TextChanged="UserNameTextBox_TextChanged" AutomationProperties.Name="اسم المستخدم"/>
                                    <TextBlock x:Name="UserNameHint" Style="{StaticResource HintText}" Text="اسم المستخدم أو البريد الإلكتروني"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Password with show / hide -->
                        <Border Style="{StaticResource FieldBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Path Data="{StaticResource LIcon.Lock}" Fill="#6B7F99" Width="22" Height="22" Stretch="Uniform" Margin="14,0,6,0"/>
                                <Grid Grid.Column="1">
                                    <PasswordBox x:Name="PasswordInput" Style="{StaticResource FieldPasswordBox}" MaxLength="256"
                                                 PasswordChanged="PasswordInput_PasswordChanged" AutomationProperties.Name="كلمة المرور"/>
                                    <TextBox x:Name="PasswordVisibleBox" Style="{StaticResource FieldTextBox}" MaxLength="256" Visibility="Collapsed"
                                             FlowDirection="LeftToRight" TextChanged="PasswordVisibleBox_TextChanged"/>
                                    <TextBlock x:Name="PasswordHint" Style="{StaticResource HintText}" Text="كلمة المرور"/>
                                </Grid>
                                <Button x:Name="TogglePasswordButton" Grid.Column="2" Style="{StaticResource EyeButtonStyle}" Margin="4,0"
                                        Click="TogglePasswordButton_Click" ToolTip="إظهار / إخفاء كلمة المرور">
                                    <Path x:Name="EyeIcon" Data="{StaticResource LIcon.EyeOff}" Fill="#6B7F99" Width="22" Height="22" Stretch="Uniform"/>
                                </Button>
                            </Grid>
                        </Border>

                        <CheckBox x:Name="RememberCheckBox" Content="تذكرني" Foreground="{StaticResource Ink}" FontSize="14"
                                  VerticalContentAlignment="Center" Margin="0,2,0,20" Cursor="Hand"/>

                        <Button x:Name="LoginButton" Style="{StaticResource LoginButtonStyle}" Content="تسجيل الدخول"
                                Click="LoginButton_Click" IsDefault="True"/>

                        <Border x:Name="ErrorBorder" Margin="0,14,0,0" Padding="10,8" Background="#FFF0F0" BorderBrush="#FFD0D0"
                                BorderThickness="1" CornerRadius="9" Visibility="Collapsed">
                            <TextBlock x:Name="ErrorText" Foreground="#C62828" FontSize="13" TextWrapping="Wrap" TextAlignment="Center"/>
                        </Border>

                        <TextBlock x:Name="ForgotPasswordText" Text="نسيت كلمة المرور؟" Foreground="{StaticResource Navy}" FontSize="14"
                                   FontWeight="SemiBold" Cursor="Hand" Margin="0,18,0,0" MouseLeftButtonUp="ForgotPassword_Click"/>
                    </StackPanel>
                </Border>

                <!-- Branding (left): flat N mark + wordmark in the application colours, then the tagline -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="60,40,24,40">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Grid Width="104" Height="104" VerticalAlignment="Center">
                            <Grid.Clip>
                                <RectangleGeometry Rect="0,0,104,104" RadiusX="26" RadiusY="26"/>
                            </Grid.Clip>
                            <Rectangle Width="104" Height="104" Fill="#0B4FB3"/>
                            <Rectangle Width="52" Height="104" HorizontalAlignment="Right" Fill="#0A74F0"/>
                            <Path Fill="White" Data="M27,76 V28 H42 L62,54 V28 H77 V76 H62 L42,50 V76 Z"/>
                        </Grid>
                        <TextBlock Margin="22,0,0,0" VerticalAlignment="Center" FontSize="66" FontWeight="SemiBold">
                            <Run Text="Nexus" Foreground="{StaticResource Navy}"/><Run Text="POS" Foreground="{StaticResource Blue}"/>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock x:Name="TaglineText" Text="إدارة ذكية.. لمبيعات أكثر" FontSize="30" FontWeight="SemiBold"
                               Foreground="{StaticResource Navy}" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Language switch: globe pill that opens a small menu -->
        <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Margin="26">
            <Button x:Name="LanguageButton" Style="{StaticResource LanguagePillStyle}" Click="LanguageButton_Click">
                <StackPanel Orientation="Horizontal">
                    <Border Width="34" Height="34" CornerRadius="9" Background="#EAF3FF" BorderBrush="#D6E6FB" BorderThickness="1">
                        <Path Data="{StaticResource LIcon.Globe}" Fill="#0B5FCC" Width="20" Height="20" Stretch="Uniform"/>
                    </Border>
                    <TextBlock x:Name="LanguageNameText" Margin="12,0,10,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource Ink}" MinWidth="58"/>
                    <Path Data="{StaticResource LIcon.ChevronDown}" Fill="#5F7390" Width="18" Height="18" Stretch="Uniform" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Popup x:Name="LanguagePopup" PlacementTarget="{Binding ElementName=LanguageButton}" Placement="Bottom" StaysOpen="False"
                   AllowsTransparency="True" PopupAnimation="Fade">
                <Border x:Name="LanguageMenu" Margin="8,6,8,14" MinWidth="190" Background="White" BorderBrush="#D3E2F5" BorderThickness="1"
                        CornerRadius="12" Padding="6">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.16" Color="#0B2A4F"/>
                    </Border.Effect>
                    <StackPanel>
                        <Button x:Name="ArabicOptionButton" Style="{StaticResource LanguageOptionStyle}" Tag="ar" Click="LanguageOption_Click">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="العربية" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}" VerticalAlignment="Center"/>
                                <Path x:Name="ArabicCheck" Grid.Column="1" Data="{StaticResource LIcon.Check}" Fill="#0A74F0" Width="18" Height="18" Stretch="Uniform"/>
                            </Grid>
                        </Button>
                        <Button x:Name="EnglishOptionButton" Style="{StaticResource LanguageOptionStyle}" Tag="en" Click="LanguageOption_Click" Margin="0,2,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="English" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Ink}" VerticalAlignment="Center"/>
                                <Path x:Name="EnglishCheck" Grid.Column="1" Data="{StaticResource LIcon.Check}" Fill="#0A74F0" Width="18" Height="18" Stretch="Uniform"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Grid>
</Window>
