<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UserSecretsId>5657daf5-a757-491c-a7cb-7eb086f7109a</UserSecretsId>
    <ApplicationIcon>Assets\Icons\NexusPOS.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Images\Card.png" />
    <None Remove="Images\Cash.png" />
    <None Remove="Images\EWallet.png" />
    <None Remove="Images\InstaPay.png" />
    <None Remove="Assets\Icons\NexusPOS.ico" />
    <None Remove="Assets\Images\nexuspos-emblem.png" />
    <None Remove="Assets\Images\nexuspos-logo.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UniversalPOS.Application\UniversalPOS.Application.csproj" />
    <ProjectReference Include="..\UniversalPOS.Infrastructure\UniversalPOS.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Icons\NexusPOS.ico" />
    <Resource Include="Assets\Images\nexuspos-emblem.png" />
    <Resource Include="Assets\Images\nexuspos-logo.png" />
    <Resource Include="Images\Card.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Images\Cash.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Images\EWallet.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Images\InstaPay.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
    <Resource Include="Images\Products\product-1.png">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Resource>
  </ItemGroup>
	<ItemGroup>
		<None Update="appsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
