<Window x:Class="UniversalPOS.Desktop.PaymentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Process Payment | NexusPOS"
        Height="610"
        Width="520"
        MinHeight="610"
        MinWidth="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F3F6FB"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="PaymentTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PaymentComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Process Payment"
                       FontSize="25"
                       FontWeight="Bold"
                       Foreground="#172B4D"/>

            <TextBlock Text="Select payment method and enter the amount"
                       FontSize="13"
                       Foreground="#64748B"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Invoice Summary -->
        <Border Grid.Row="1"
                Background="#172B4D"
                CornerRadius="12"
                Padding="18"
                Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="INVOICE TOTAL"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#CBD5E1"/>

                    <TextBlock x:Name="InvoiceTotalTextBlock"
                               Text="0.00 EGP"
                               FontSize="25"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Background="#29446A"
                        CornerRadius="8"
                        Padding="12"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="InvoiceNumberTextBlock"
                               Text="Invoice # —"
                               Foreground="White"
                               FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <!-- Payment Details -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <TextBlock Text="Primary Payment Method"
                           Style="{StaticResource FieldLabelStyle}"/>

                <ComboBox x:Name="PrimaryPaymentMethodComboBox"
                          Style="{StaticResource PaymentComboBoxStyle}"/>
                <Border Margin="0,12,0,12"
        Padding="15"
        BorderBrush="#DDDDDD"
        BorderThickness="1"
        CornerRadius="10">

                    <StackPanel>
                        <TextBlock x:Name="PaymentInstructionsTitle"
                   Text="Payment Instructions"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,8"/>

                        <Image x:Name="PaymentLogo"
       Width="150"
       Height="65"
       Stretch="Uniform"
       Visibility="Visible"
       HorizontalAlignment="Left"
       Margin="0,0,0,10"/>

                        <TextBlock x:Name="PaymentInstructionsText" Text="Select a payment method to see the instructions." TextWrapping="Wrap" FontSize="14"/>

                        <StackPanel x:Name="WalletProviderPanel"
            Visibility="Collapsed"
            Margin="0,12,0,0">

                            <TextBlock Text="Select Wallet Provider"
               FontSize="14"
               FontWeight="SemiBold"
               Margin="0,0,0,6"/>

                            <ComboBox x:Name="WalletProviderComboBox"
              Height="35"
              SelectedIndex="0">

                                <ComboBoxItem Content="Vodafone Cash"/>
                                <ComboBoxItem Content="Orange Cash"/>
                                <ComboBoxItem Content="e&amp; cash"/>
                                <ComboBoxItem Content="WE Pay"/>

                            </ComboBox>
                        </StackPanel>

                    </StackPanel>
                </Border>

                <TextBlock Text="Primary Payment Amount"
                           Style="{StaticResource FieldLabelStyle}"
                           Margin="0,16,0,7"/>

                <TextBox x:Name="PrimaryPaymentAmountTextBox"
                         Style="{StaticResource PaymentTextBoxStyle}"
                         Text="0.00"/>

                <CheckBox x:Name="EnableSplitPaymentCheckBox"
                          Content="Split payment between two methods"
                          FontSize="13"
                          FontWeight="SemiBold"
                          Foreground="#334155"
                          Margin="0,20,0,16"
                          Checked="EnableSplitPaymentCheckBox_Changed"
                          Unchecked="EnableSplitPaymentCheckBox_Changed"/>

                <Border x:Name="SecondaryPaymentPanel"
                        Background="White"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14"
                        Visibility="Collapsed">

                    <StackPanel>
                        <TextBlock Text="SECONDARY PAYMENT"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   Foreground="#64748B"
                                   Margin="0,0,0,14"/>

                        <TextBlock Text="Secondary Payment Method"
                                   Style="{StaticResource FieldLabelStyle}"/>

                        <ComboBox x:Name="SecondaryPaymentMethodComboBox"
                                  Style="{StaticResource PaymentComboBoxStyle}"/>

                        <TextBlock Text="Secondary Payment Amount"
                                   Style="{StaticResource FieldLabelStyle}"
                                   Margin="0,14,0,7"/>

                        <TextBox x:Name="SecondaryPaymentAmountTextBox"
                                 Style="{StaticResource PaymentTextBoxStyle}"
                                 Text="0.00"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <StackPanel Grid.Row="3" Margin="0,18,0,0">

            <Border Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14"
                    Margin="0,0,0,16">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="Outstanding Balance"
                                   FontSize="12"
                                   Foreground="#64748B"/>

                        <TextBlock x:Name="OutstandingBalanceTextBlock"
                                   Text="0.00 EGP"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="#172B4D"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <TextBlock x:Name="PaymentValidationTextBlock"
                               Grid.Column="1"
                               Text=""
                               FontSize="12"
                               Foreground="#DC2626"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="150"/>
                </Grid>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="1.5*"/>
                </Grid.ColumnDefinitions>

                <Button Content="Cancel"
                        Height="44"
                        IsCancel="True"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Background="White"
                        Foreground="#334155"
                        BorderBrush="#CBD5E1"
                        BorderThickness="1"/>

                <Button x:Name="ConfirmPaymentButton"
                        Grid.Column="2"
                        Content="Confirm Payment"
                        Height="44"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        Click="ConfirmPaymentButton_Click"/>
            </Grid>

        </StackPanel>
    </Grid>
</Window>
